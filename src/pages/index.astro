---
import Layout from '../layouts/Layout.astro';
---

<Layout title="IncubaUNAS | Conéctate, Suscríbete y Crea Eventos Extraordinarios" activeNav="inicio">
  <!-- 2. Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-16 lg:pb-24 border-b border-surface-container-highest bg-gradient-to-b from-surface-container-lowest via-background to-surface-container-low">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <!-- Header & Pitch -->
      <div class="text-center max-w-4xl mx-auto space-y-5">
        <h1 class="text-display font-display text-on-surface tracking-tight leading-tight">
          Conéctate, Suscríbete y Crea <span class="text-primary">Eventos Extraordinarios</span>
        </h1>
        <p class="text-body-lg font-body-lg text-secondary max-w-2xl mx-auto">
          Somos la incubadora de la Universidad Nacional Agraria de la Selva. Brindamos asesoría y asistencia técnica para la creación de emprendimientos innovadores.
        </p>
        <!-- CTAs -->
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a
            class="bg-primary-container hover:bg-primary text-on-primary font-semibold px-6 py-3 rounded-lg shadow-sm transition-all duration-200 ease-in-out active:scale-95 flex items-center gap-2 text-label-lg font-label-lg"
            href="/eventos"
          >
            <span class="material-symbols-outlined" data-icon="explore">explore</span>
            Explorar Eventos
          </a>
          <a
            class="bg-surface-container-lowest border border-on-surface hover:bg-on-surface hover:text-surface-container-lowest text-on-surface font-semibold px-6 py-3 rounded-lg transition-all duration-200 ease-in-out active:scale-95 flex items-center gap-2 text-label-lg font-label-lg"
            href="/convocar"
          >
            <span class="material-symbols-outlined" data-icon="add_circle">add_circle</span>
            Crear mi Evento
          </a>
        </div>
      </div>

      <!-- Featured Event Cards Preview (Bento Showcase) -->
      <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="eventos">
        <!-- Card 1: Tech Summit 2025 -->
        <article class="bg-surface-container-lowest border border-surface-container-highest rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 group flex flex-col">
          <div class="relative h-48 w-full overflow-hidden bg-surface-container">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              alt="Global Tech Summit 2025"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDqzJsWIWe-2fSwJr3PHssJz5sS_KGi6SEcw2XXO_3KGD-RUVHhIKEE8TVZxMsJ-ToH1lU3AoJiyuEOsdQMhqq_OBlGevCRK2Vy2-r8VXxa5yeVHZbNbFpgZmGbISj71thq3wUpejQS94Wjl5KnEdvI-6ULs9sJA_bTY-JsF5NFQXHu9LEzqBP1C1sxkJHuaQCPOw8l2nbVMRWxQxaR__fDazOHJLRb-TuZ_TS7-Tw"
            />
            <div class="absolute top-3 left-3 bg-tertiary-fixed text-on-tertiary-fixed px-2.5 py-1 rounded-full text-label-sm font-label-sm flex items-center gap-1 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-ping"></span>
              En vivo
            </div>
            <div class="absolute top-3 right-3 bg-surface-container-lowest/90 backdrop-blur text-on-surface px-2.5 py-0.5 rounded-md text-label-sm font-label-sm">
              Tecnología
            </div>
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <div class="flex items-center gap-2 text-secondary text-body-sm font-body-sm mb-2">
                <span class="material-symbols-outlined text-base text-primary" data-icon="calendar_month">calendar_month</span>
                <span>14 - 16 Noviembre, 2025</span>
              </div>
              <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">
                Global Tech Summit 2025: Cloud & AI
              </h3>
              <p class="text-secondary text-body-sm font-body-sm mt-2 line-clamp-2">
                El congreso tecnológico líder que reúne a directores de tecnología, fundadores de startups e ingenieros de software pioneros en Latinoamérica.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-surface-container-highest flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary text-base" data-icon="place">place</span>
                <span class="text-body-sm font-body-sm text-secondary">Ciudad Digital & Streaming</span>
              </div>
              <a class="text-primary font-bold text-label-lg font-label-lg inline-flex items-center gap-1 hover:underline" href="/eventos">
                Registrarse
                <span class="material-symbols-outlined text-base" data-icon="arrow_forward">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Card 2: Masterclass Innovación -->
        <article class="bg-surface-container-lowest border border-surface-container-highest rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 group flex flex-col">
          <div class="relative h-48 w-full overflow-hidden bg-surface-container">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              alt="Masterclass de Innovación"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBfVKZaYB45vsZuK3WdaaPnusdkNhTs1aOat3EwTU81b8MjtZYPvPCAh21Fo-H-J3PKboOWnzmeaoh5s7iA5WCYhRrSKHiYAoiMcR_elykGwQXjOU54dU6L6rqq_A87FUDr3cqJo8nj5-_MKJPlGJDeYzBS2NJ0IVrGSuibRTUvF0w6azIspVsDGQGffYq1h9OvTqfoYJ39G-viLH4vps9I5Xm3TJK3JPqKr17za0A"
            />
            <div class="absolute top-3 left-3 bg-tertiary-fixed text-on-tertiary-fixed px-2.5 py-1 rounded-full text-label-sm font-label-sm flex items-center gap-1 shadow-sm">
              <span class="material-symbols-outlined text-xs" data-icon="check_circle">check_circle</span>
              Inscripciones abiertas
            </div>
            <div class="absolute top-3 right-3 bg-surface-container-lowest/90 backdrop-blur text-on-surface px-2.5 py-0.5 rounded-md text-label-sm font-label-sm">
              Masterclass
            </div>
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <div class="flex items-center gap-2 text-secondary text-body-sm font-body-sm mb-2">
                <span class="material-symbols-outlined text-base text-primary" data-icon="calendar_month">calendar_month</span>
                <span>28 Noviembre, 2025</span>
              </div>
              <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">
                Masterclass de Innovación y Venture Capital
              </h3>
              <p class="text-secondary text-body-sm font-body-sm mt-2 line-clamp-2">
                Aprende estrategias de levantamiento de capital institucional, estructuración de rondas seed y escalamiento acelerado con socios inversores.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-surface-container-highest flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary text-base" data-icon="place">place</span>
                <span class="text-body-sm font-body-sm text-secondary">Campus Central & Online</span>
              </div>
              <a class="text-primary font-bold text-label-lg font-label-lg inline-flex items-center gap-1 hover:underline" href="/eventos">
                Registrarse
                <span class="material-symbols-outlined text-base" data-icon="arrow_forward">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Card 3: Design & Product Expo -->
        <article class="bg-surface-container-lowest border border-surface-container-highest rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 group flex flex-col">
          <div class="relative h-48 w-full overflow-hidden bg-surface-container">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              alt="Product Experience Forum & Expo"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAy4ZElrzTlf4SrtIEygWIEiT0qVLVv_Pl7yjNs6lO9ZgaAKNV-7h1SeUtMlfNem1upNCB12q-bgTBQao_OF2NQLD8Mc0h95FY3oKhBTu_vL0PqcLCAXbADvS7g5Y652C_BSY3fERA7pE1DecdUYDP-T6dwl5F35e6uLS7Q54Hv0KUq8j0ToSscDgm0FXlQCYNX42zZMbAlbyzLOhozCskb4yPjJIzYLbmWEz3y_8M"
            />
            <div class="absolute top-3 left-3 bg-tertiary-fixed text-on-tertiary-fixed px-2.5 py-1 rounded-full text-label-sm font-label-sm flex items-center gap-1 shadow-sm">
              <span class="material-symbols-outlined text-xs" data-icon="stars">stars</span>
              Últimos cupos
            </div>
            <div class="absolute top-3 right-3 bg-surface-container-lowest/90 backdrop-blur text-on-surface px-2.5 py-0.5 rounded-md text-label-sm font-label-sm">
              Diseño
            </div>
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <div class="flex items-center gap-2 text-secondary text-body-sm font-body-sm mb-2">
                <span class="material-symbols-outlined text-base text-primary" data-icon="calendar_month">calendar_month</span>
                <span>05 Diciembre, 2025</span>
              </div>
              <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">
                Product Experience Forum & Expo
              </h3>
              <p class="text-secondary text-body-sm font-body-sm mt-2 line-clamp-2">
                Un encuentro exclusivo para diseñadores de experiencia, líderes de producto y directores creativos enfocados en interfaces de próxima generación.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-surface-container-highest flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary text-base" data-icon="place">place</span>
                <span class="text-body-sm font-body-sm text-secondary">Hub de Innovación</span>
              </div>
              <a class="text-primary font-bold text-label-lg font-label-lg inline-flex items-center gap-1 hover:underline" href="/eventos">
                Registrarse
                <span class="material-symbols-outlined text-base" data-icon="arrow_forward">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Data Section (Métricas y Cifras Clave) -->
  <section class="py-16 bg-surface-container-lowest border-b border-surface-container-highest">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Metrica 1 -->
        <div class="p-6 rounded-xl border border-surface-container-highest bg-background hover:bg-surface-container-low transition-colors duration-150">
          <p class="text-display font-display text-on-surface tracking-tight leading-none mb-2">+10</p>
          <h4 class="text-title font-title text-on-surface">Programas</h4>
        </div>
        <!-- Metrica 2 -->
        <div class="p-6 rounded-xl border border-surface-container-highest bg-background hover:bg-surface-container-low transition-colors duration-150">
          <p class="text-display font-display text-on-surface tracking-tight leading-none mb-2">+300</p>
          <h4 class="text-title font-title text-on-surface">Emprendedores impactados</h4>
        </div>
        <!-- Metrica 3 -->
        <div class="p-6 rounded-xl border border-surface-container-highest bg-background hover:bg-surface-container-low transition-colors duration-150">
          <p class="text-display font-display text-tertiary-container tracking-tight leading-none mb-2">+40</p>
          <h4 class="text-title font-title text-on-surface">Startups incubadas</h4>
        </div>
        <!-- Metrica 4 -->
        <div class="p-6 rounded-xl border border-surface-container-highest bg-background hover:bg-surface-container-low transition-colors duration-150">
          <p class="text-display font-display text-on-surface tracking-tight leading-none mb-2">$500k</p>
          <h4 class="text-title font-title text-on-surface">Capital semilla</h4>
        </div>
        <!-- Metrica 5: Mentores -->
        <div class="p-6 rounded-xl border border-surface-container-highest bg-background hover:bg-surface-container-low transition-colors duration-150">
          <p class="text-display font-display text-primary tracking-tight leading-none mb-2">+20</p>
          <h4 class="text-title font-title text-on-surface">Mentores</h4>
        </div>
        <!-- Metrica 6: Startups Financiadas -->
        <div class="p-6 rounded-xl border border-surface-container-highest bg-background hover:bg-surface-container-low transition-colors duration-150">
          <p class="text-display font-display text-on-surface tracking-tight leading-none mb-2">+8</p>
          <h4 class="text-title font-title text-on-surface">Startups Financiadas</h4>
        </div>
        <!-- Metrica 7: Talleres -->
        <div class="p-6 rounded-xl border border-surface-container-highest bg-background hover:bg-surface-container-low transition-colors duration-150">
          <p class="text-display font-display text-on-surface tracking-tight leading-none mb-2">+30</p>
          <h4 class="text-title font-title text-on-surface">Talleres</h4>
        </div>
        <!-- Metrica 8: Congresos -->
        <div class="p-6 rounded-xl border border-surface-container-highest bg-background hover:bg-surface-container-low transition-colors duration-150">
          <p class="text-display font-display text-tertiary-container tracking-tight leading-none mb-2">+2</p>
          <h4 class="text-title font-title text-on-surface">Congresos</h4>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Awards and Merits (Premios y Reconocimientos) -->
  <section class="py-16 bg-surface-container-low border-b border-surface-container-highest">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="flex flex-col items-center text-center justify-center mb-10 gap-3 max-w-2xl mx-auto">
        <h2 class="text-headline-lg font-headline-lg text-on-surface mt-1">Premios y Reconocimientos</h2>
        <p class="text-secondary text-body-md font-body-md max-w-md text-center">
          Avalados por organismos internacionales de tecnología, auditoría de pagos y gremios de organizadores profesionales.
        </p>
      </div>
      <div class="max-w-5xl mx-auto flex flex-wrap justify-center gap-6">
        <div class="bg-surface-container-lowest p-6 rounded-xl border border-surface-container-highest shadow-sm flex flex-col items-center justify-center text-center flex-1 min-w-[260px] max-w-sm hover:shadow-md transition-all duration-200 group">
          <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-primary mb-4 group-hover:scale-105 transition-transform">
            <span class="material-symbols-outlined text-2xl" data-icon="emoji_events">emoji_events</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">
            Primera incubadora en llevar emprendimientos amazónicos a Europa
          </h3>
        </div>

        <div class="bg-surface-container-lowest p-6 rounded-xl border border-surface-container-highest shadow-sm flex flex-col items-center justify-center text-center flex-1 min-w-[260px] max-w-sm hover:shadow-md transition-all duration-200 group">
          <div class="w-12 h-12 rounded-xl bg-tertiary-fixed flex items-center justify-center text-tertiary-container mb-4 group-hover:scale-105 transition-transform">
            <span class="material-symbols-outlined text-2xl" data-icon="workspace_premium">workspace_premium</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">
            2 startups en Programas de Mentor Day - España
          </h3>
        </div>

        <div class="bg-surface-container-lowest p-6 rounded-xl border border-surface-container-highest shadow-sm flex flex-col items-center justify-center text-center flex-1 min-w-[260px] max-w-sm hover:shadow-md transition-all duration-200 group">
          <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-primary mb-4 group-hover:scale-105 transition-transform">
            <span class="material-symbols-outlined text-2xl" data-icon="military_tech">military_tech</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">
            Articulación con Gobiernos regionales y toda la Red CITE
          </h3>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. What We Offer (Lo que ofrecemos) -->
  <section class="py-16 lg:py-20 bg-surface-container-lowest border-b border-surface-container-highest" id="programas-resumen">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-headline-lg font-headline-lg text-on-surface mt-1">Lo que Ofrecemos para Asistentes y Creadores</h2>
        <p class="text-secondary text-body-md font-body-md mt-2">
          Una suite holística creada tanto para entusiastas que buscan conectar como para marcas que producen experiencias masivas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
        <div class="bg-surface-container-lowest p-6 rounded-xl border border-surface-container-highest shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between items-center text-center group">
          <div class="space-y-4 flex flex-col items-center">
            <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform mx-auto">
              <span class="material-symbols-outlined text-2xl" data-icon="supervisor_account">supervisor_account</span>
            </div>
            <div>
              <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">Mentoría</h3>
              <p class="text-secondary text-body-sm font-body-sm mt-2 leading-relaxed">Acompañamiento personalizado y soporte en fondos concursables.</p>
            </div>
          </div>
        </div>

        <div class="bg-surface-container-lowest p-6 rounded-xl border border-surface-container-highest shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between items-center text-center group">
          <div class="space-y-4 flex flex-col items-center">
            <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform mx-auto">
              <span class="material-symbols-outlined text-2xl" data-icon="school">school</span>
            </div>
            <div>
              <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">Capacitaciones</h3>
              <p class="text-secondary text-body-sm font-body-sm mt-2 leading-relaxed">Formación para fortalecer ideas y negocios sostenibles.</p>
            </div>
          </div>
        </div>

        <div class="bg-surface-container-lowest p-6 rounded-xl border border-surface-container-highest shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between items-center text-center group">
          <div class="space-y-4 flex flex-col items-center">
            <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform mx-auto">
              <span class="material-symbols-outlined text-2xl" data-icon="hub">hub</span>
            </div>
            <div>
              <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">Networking</h3>
              <p class="text-secondary text-body-sm font-body-sm mt-2 leading-relaxed">Acceso a una red de emprendedores y mentores.</p>
            </div>
          </div>
        </div>

        <div class="bg-surface-container-lowest p-6 rounded-xl border border-surface-container-highest shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between items-center text-center group">
          <div class="space-y-4 flex flex-col items-center">
            <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform mx-auto">
              <span class="material-symbols-outlined text-2xl" data-icon="domain">domain</span>
            </div>
            <div>
              <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">Coworking</h3>
              <p class="text-secondary text-body-sm font-body-sm mt-2 leading-relaxed">Espacios de trabajo colaborativo totalmente equipados.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Our Allies (Nuestros aliados) -->
  <section class="py-16 bg-surface-container-low border-b border-surface-container-highest">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-headline-lg font-headline-lg text-on-surface mt-1">Nuestros Aliados</h2>
        <p class="text-secondary text-body-md font-body-md mt-2">Empresas e instituciones que confían y colaboran con nuestra incubadora</p>
      </div>

      <div class="mt-8 max-w-5xl mx-auto bg-surface-container-lowest p-6 sm:p-8 rounded-2xl border border-surface-container-highest shadow-sm flex items-center justify-center">
        <img
          class="w-full h-auto object-contain max-h-[420px] rounded-lg"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCxu04CPTiH8gcuRWsJZ3O_iKUyklucSGhLF20fhcGOQLNhNO5Murk9ZnaduZZo2wy0XUfzSbHsUexEnwbdrdfAWKbNbUWzcdg_2rudCmWctOfKJWSMUaEGivuIBjVAQLBr_lmTt4AylM4j6WxEZOmkeUF4QFMZDCuDqrS49j9yI9dfBREe1pTXQSCeTJNvnXNymyWvHCOSsLhSvUafYbQK7q_hZkIzuhQB8H6FnydScKqxYOQdM4-u"
          alt="Aliados IncubaUNAS"
        />
      </div>
    </div>
  </section>
</Layout>
