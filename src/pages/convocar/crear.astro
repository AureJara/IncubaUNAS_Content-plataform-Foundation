<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tag Pills
    const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
    const activeTagsWrapper = document.getElementById('activeTagsWrapper');
    const customTagInput = document.getElementById('customTagInput') as HTMLInputElement | null;
    const addTagBtn = document.getElementById('addTagBtn');

    function addTagChip(name: string) {
      if (!activeTagsWrapper) return;
      const span = document.createElement('span');
      span.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm';
      span.innerHTML = `<span>${name}</span><button type="button" class="hover:text-error transition-colors flex items-center ml-1"><span class="material-symbols-outlined text-sm">close</span></button>`;
      span.querySelector('button')?.addEventListener('click', () => {
        span.remove();
        // Also unselect button if present
        tagButtons.forEach((b) => {
          if (b.getAttribute('data-tag') === name) {
            b.classList.remove('border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
            b.classList.add('border-surface-container-highest', 'bg-surface-container-low', 'text-secondary');
            const icon = b.querySelector('.material-symbols-outlined');
            if (icon) icon.textContent = 'add';
          }
        });
      });
      activeTagsWrapper.appendChild(span);
    }

    // Attach listener to existing remove buttons
    document.querySelectorAll('.remove-tag-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.closest('span')?.remove();
      });
    });

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tagName = btn.getAttribute('data-tag') || '';
        const isSelected = btn.classList.contains('border-primary');
        const iconSpan = btn.querySelector('.material-symbols-outlined');

        if (isSelected) {
          btn.classList.remove('border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          btn.classList.add('border-surface-container-highest', 'bg-surface-container-low', 'text-secondary');
          if (iconSpan) iconSpan.textContent = 'add';
          // Remove chip
          const chips = activeTagsWrapper?.querySelectorAll('span.inline-flex');
          chips?.forEach((c) => {
            if (c.textContent?.includes(tagName)) c.remove();
          });
        } else {
          btn.classList.add('border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          btn.classList.remove('border-surface-container-highest', 'bg-surface-container-low', 'text-secondary');
          if (iconSpan) iconSpan.textContent = 'check';
          addTagChip(tagName);
        }
      });
    });

    if (addTagBtn && customTagInput) {
      const handleAdd = () => {
        const val = customTagInput.value.trim();
        if (val) {
          addTagChip(val);
          customTagInput.value = '';
        }
      };
      addTagBtn.addEventListener('click', handleAdd);
      customTagInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleAdd();
        }
      });
    }

    // 2. Affiliation Checkboxes
    const affiliationCheckboxes = document.querySelectorAll<HTMLInputElement>('.affiliation-checkbox');
    const countText = document.getElementById('affiliationCountText');
    const counterContainer = document.getElementById('affiliationCounter');
    const alertMessage = document.getElementById('affiliationAlert');

    function updateAffiliationCount() {
      const checkedCount = document.querySelectorAll<HTMLInputElement>('.affiliation-checkbox:checked').length;
      if (countText && counterContainer && alertMessage) {
        if (checkedCount === 0) {
          countText.textContent = '0 entidades (Requerido)';
          counterContainer.classList.remove('text-tertiary', 'bg-tertiary-container/10', 'border-tertiary-container/30');
          counterContainer.classList.add('text-error', 'bg-error-container/40', 'border-error-container');
          alertMessage.classList.remove('hidden');
        } else {
          countText.textContent = `${checkedCount} entidad${checkedCount > 1 ? 'es' : ''} seleccionada${checkedCount > 1 ? 's' : ''}`;
          counterContainer.classList.add('text-tertiary', 'bg-tertiary-container/10', 'border-tertiary-container/30');
          counterContainer.classList.remove('text-error', 'bg-error-container/40', 'border-error-container');
          alertMessage.classList.add('hidden');
        }
      }

      document.querySelectorAll('.affiliation-card').forEach((card) => {
        const checkbox = card.querySelector<HTMLInputElement>('input[type="checkbox"]');
        if (checkbox && checkbox.checked) {
          card.classList.add('border-primary', 'bg-primary/5', 'border-2');
          card.classList.remove('border-surface-container-highest', 'bg-surface-container-lowest', 'border');
        } else if (checkbox) {
          card.classList.remove('border-primary', 'bg-primary/5', 'border-2');
          card.classList.add('border-surface-container-highest', 'bg-surface-container-lowest', 'border');
        }
      });
    }

    affiliationCheckboxes.forEach((cb) => {
      cb.addEventListener('change', updateAffiliationCount);
    });

    // 3. Dynamic Sessions
    let sessionCounter = 2;
    const addSessionBtn = document.getElementById('addSessionBtn');
    const sessionsContainer = document.getElementById('sessionsContainer');
    const sessionCountText = document.getElementById('sessionCountText');

    function updateSessionCount() {
      const count = document.querySelectorAll('.session-card').length;
      if (sessionCountText) {
        sessionCountText.textContent = `${count} jornada${count > 1 ? 's' : ''}`;
      }
    }

    document.querySelectorAll('.delete-session-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.closest('.session-card')?.remove();
        updateSessionCount();
      });
    });

    if (addSessionBtn && sessionsContainer) {
      addSessionBtn.addEventListener('click', () => {
        sessionCounter++;
        const newCard = document.createElement('div');
        newCard.className = 'session-card border border-surface-container-highest rounded-xl p-5 bg-surface-bright relative transition-all duration-150 hover:border-outline-variant';
        newCard.innerHTML = `
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-surface-container text-on-surface text-label-sm font-label-sm font-bold flex items-center justify-center">${sessionCounter}</span>
              <span class="font-title text-title text-on-surface font-bold">Sesión ${sessionCounter}: Nueva Jornada</span>
            </div>
            <button type="button" class="delete-session-btn text-error hover:text-on-error-container p-1 rounded hover:bg-error-container/30 transition-colors flex items-center gap-1 font-label-sm text-label-sm">
              <span class="material-symbols-outlined text-base">delete</span>
              <span>Eliminar sesión</span>
            </button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-4">
              <label class="block font-label-sm text-label-sm text-on-surface mb-1.5">Nombre de la sesión *</label>
              <input type="text" placeholder="Ej: Sesión ${sessionCounter}: Ronda de Validación" required
                class="w-full bg-surface-container-lowest border border-surface-container-highest rounded-lg px-3.5 py-2.5 text-body-sm font-body-sm text-on-surface focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none">
            </div>
            <div class="md:col-span-3">
              <label class="block font-label-sm text-label-sm text-on-surface mb-1.5">Fecha *</label>
              <input type="date" required
                class="w-full bg-surface-container-lowest border border-surface-container-highest rounded-lg px-3 py-2.5 text-body-sm font-body-sm text-on-surface focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none">
            </div>
            <div class="md:col-span-2">
              <label class="block font-label-sm text-label-sm text-on-surface mb-1.5">Hora Inicio *</label>
              <input type="time" value="09:00" required
                class="w-full bg-surface-container-lowest border border-surface-container-highest rounded-lg px-3 py-2.5 text-body-sm font-body-sm text-on-surface focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none">
            </div>
            <div class="md:col-span-3">
              <label class="block font-label-sm text-label-sm text-on-surface mb-1.5">Hora Fin *</label>
              <input type="time" value="12:00" required
                class="w-full bg-surface-container-lowest border border-surface-container-highest rounded-lg px-3 py-2.5 text-body-sm font-body-sm text-on-surface focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none">
            </div>
            <div class="md:col-span-4">
              <label class="block font-label-sm text-label-sm text-on-surface mb-1.5">Modalidad</label>
              <select class="w-full bg-surface-container-lowest border border-surface-container-highest rounded-lg px-3.5 py-2.5 text-body-sm font-body-sm text-on-surface focus:border-primary outline-none">
                <option selected>Presencial (Campus Universitario)</option>
                <option>Virtual (Zoom / Google Meet)</option>
                <option>Híbrida</option>
              </select>
            </div>
            <div class="md:col-span-8">
              <label class="block font-label-sm text-label-sm text-on-surface mb-1.5">Lugar / Aula o Enlace Virtual *</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-base">pin_drop</span>
                <input type="text" placeholder="Ej: Auditorio de Agronomía" required
                  class="w-full bg-surface-container-lowest border border-surface-container-highest rounded-lg pl-9 pr-3 py-2.5 text-body-sm font-body-sm text-on-surface focus:border-primary outline-none">
              </div>
            </div>
          </div>
        `;
        newCard.querySelector('.delete-session-btn')?.addEventListener('click', () => {
          newCard.remove();
          updateSessionCount();
        });
        sessionsContainer.appendChild(newCard);
        updateSessionCount();
      });
    }

    // 4. Invite Collaborators
    const addCollaboratorBtn = document.getElementById('addCollaboratorBtn');
    const collaboratorEmail = document.getElementById('collaboratorEmail') as HTMLInputElement | null;
    const collaboratorRole = document.getElementById('collaboratorRole') as HTMLSelectElement | null;
    const collaboratorsChipsWrapper = document.getElementById('collaboratorsChipsWrapper');

    if (addCollaboratorBtn && collaboratorEmail && collaboratorRole && collaboratorsChipsWrapper) {
      addCollaboratorBtn.addEventListener('click', () => {
        const email = collaboratorEmail.value.trim();
        if (!email || !email.includes('@')) {
          collaboratorEmail.focus();
          return;
        }
        const role = collaboratorRole.value;
        const chip = document.createElement('div');
        chip.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-surface-container-highest text-body-sm font-body-sm';
        chip.innerHTML = `
          <span class="material-symbols-outlined text-sm text-primary">person</span>
          <span>${email}</span>
          <span class="text-xs bg-secondary-container px-1.5 py-0.5 rounded text-secondary font-medium">${role}</span>
          <button type="button" class="text-outline hover:text-error transition-colors"><span class="material-symbols-outlined text-sm">close</span></button>
        `;
        chip.querySelector('button')?.addEventListener('click', () => chip.remove());
        collaboratorsChipsWrapper.appendChild(chip);
        collaboratorEmail.value = '';
      });
    }

    // 5. Validation and Publish
    const publishBtn = document.getElementById('publishBtn');
    if (publishBtn) {
      publishBtn.addEventListener('click', () => {
        const checkedAffiliations = document.querySelectorAll<HTMLInputElement>('.affiliation-checkbox:checked').length;
        const sessionCards = document.querySelectorAll('.session-card').length;
        const titleInput = document.getElementById('eventTitle') as HTMLInputElement | null;
        const title = titleInput?.value.trim();

        if (!title) {
          alert('Por favor ingrese el título del evento.');
          titleInput?.focus();
          return;
        }

        if (checkedAffiliations === 0) {
          alert('Atención: Debe seleccionar al menos una afiliación o entidad convocante obligatoria.');
          document.getElementById('affiliationGrid')?.scrollIntoView({ behavior: 'smooth' });
          return;
        }

        if (sessionCards === 0) {
          alert('Atención: Debe registrar al menos una sesión de fecha y hora para el cronograma del evento.');
          return;
        }

        alert('¡Convocatoria enviada con éxito! El equipo de coordinación de IncubaUNAS revisará los datos para habilitar la inscripción pública.');
      });
    }
  });
</script>
