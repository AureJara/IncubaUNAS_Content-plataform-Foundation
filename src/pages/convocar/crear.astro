---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Crear Convocatoria | IncubaUNAS" activeNav="convocar">
  <!-- Subbar with authenticated user info -->
  <div class="bg-surface-container-low border-b border-surface-container-highest px-6 py-3">
    <div class="max-w-7xl mx-auto flex justify-between items-center text-body-sm">
      <div class="flex items-center gap-2 text-secondary">
        <a href="/convocar" class="hover:text-primary transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">arrow_back</span>
          Convocar
        </a>
        <span>/</span>
        <span class="text-on-surface font-semibold">Nueva Convocatoria</span>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-primary text-on-primary font-bold text-xs flex items-center justify-center">
            CP
          </div>
          <span class="text-on-surface font-semibold text-xs hidden sm:inline">Carlos Pérez (Organizador)</span>
        </div>
        <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-tertiary/10 text-tertiary font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
          Sesión Activa
        </span>
      </div>
    </div>
  </div>

  <!-- MAIN CANVAS WITH SIDEBAR -->
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex gap-8 items-start">
    <!-- ASIDE SIDEBAR -->
    <aside class="hidden lg:flex flex-col w-64 shrink-0 bg-surface-container-lowest rounded-xl border border-surface-container-highest p-4 sticky top-24 shadow-sm space-y-6">
      <div class="space-y-1">
        <div class="px-3 py-2 text-xs font-bold text-secondary uppercase tracking-wider">Gestión UNAS</div>
        <nav class="space-y-1">
          <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container text-label-lg font-label-lg transition-colors" href="#">
            <span class="material-symbols-outlined text-xl">dashboard</span>
            <span>Panel Principal</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container text-label-lg font-label-lg transition-colors" href="/eventos">
            <span class="material-symbols-outlined text-xl">event</span>
            <span>Mis Convocatorias</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-primary text-on-primary text-label-lg font-label-lg font-bold shadow-sm" href="/convocar/crear">
            <span class="material-symbols-outlined text-xl">add_circle</span>
            <span>Crear Convocatoria</span>
          </a>
          <a class="flex items-center justify-between px-3 py-2.5 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container text-label-lg font-label-lg transition-colors" href="#">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-xl">how_to_reg</span>
              <span>Postulantes</span>
            </div>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container">14</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container text-label-lg font-label-lg transition-colors" href="/nosotros">
            <span class="material-symbols-outlined text-xl">group</span>
            <span>Equipo & Mentores</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container text-label-lg font-label-lg transition-colors" href="/portafolio">
            <span class="material-symbols-outlined text-xl">emoji_events</span>
            <span>Participaciones</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container text-label-lg font-label-lg transition-colors" href="#">
            <span class="material-symbols-outlined text-xl">settings</span>
            <span>Configuración</span>
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t border-surface-container-highest">
        <div class="p-3 rounded-lg bg-surface-container-low/70 border border-surface-container-highest flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-primary-fixed text-primary font-bold flex items-center justify-center text-xs">CU</div>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-on-surface">IncubaUNAS Hub</span>
              <span class="text-[11px] text-tertiary font-medium">Online</span>
            </div>
          </div>
          <a href="/acceder" class="text-secondary hover:text-error transition-colors p-1" title="Cerrar sesión">
            <span class="material-symbols-outlined text-lg">logout</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- MAIN FORM COLUMN -->
    <div class="flex-1 min-w-0">
      <!-- Title & Status row -->
      <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Crear Convocatoria</h1>
            <p class="font-body-md text-body-md text-secondary mt-1.5 max-w-3xl">
              Publica y gestiona eventos, talleres y convocatorias de incubación y aceleración para el ecosistema emprendedor e innovador de la UNAS.
            </p>
          </div>
          <div class="flex items-center gap-3 bg-surface-container-lowest border border-surface-container-highest px-4 py-2.5 rounded-xl shadow-sm self-start md:self-auto">
            <div class="h-3 w-3 rounded-full bg-tertiary animate-pulse"></div>
            <div>
              <div class="font-label-sm text-label-sm text-secondary">Estado del Registro</div>
              <div class="font-label-lg text-label-lg text-on-surface font-semibold flex items-center gap-1.5">
                <span>Borrador Activo</span>
                <span class="text-tertiary font-normal text-xs">(Auto-guardado)</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 bg-secondary-container/40 border border-secondary-container rounded-xl p-4 flex items-start gap-3.5">
          <span class="material-symbols-outlined text-primary text-xl mt-0.5">info</span>
          <div class="text-body-sm font-body-sm text-on-secondary-variant">
            <span class="font-semibold text-on-surface">Requisitos indispensables para publicación oficial:</span>
            Debe seleccionar <strong class="text-on-surface">al menos una afiliación o entidad convocante</strong> y programar <strong class="text-on-surface">al menos una sesión con fecha y horario</strong>. Las solicitudes serán validadas por la coordinación de IncubaUNAS.
          </div>
        </div>
      </div>

      <!-- FORM -->
      <form class="space-y-8" id="createEventForm" onsubmit="event.preventDefault();">
        <!-- 1. Información General -->
        <section class="bg-surface-container-lowest rounded-xl border border-surface-container-highest p-6 lg:p-8 shadow-sm transition-all duration-200 hover:border-outline-variant">
          <div class="flex items-center gap-3 pb-5 border-b border-surface-container mb-6">
            <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-fixed text-primary font-headline-sm text-sm font-bold">1</span>
            <div>
              <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Información General del Evento</h2>
              <p class="font-body-sm text-body-sm text-secondary">Define el título principal, alcance temático y descripción del programa o taller.</p>
            </div>
          </div>

          <div class="space-y-6">
            <div>
              <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="eventTitle">
                Título del evento <span class="text-error">*</span>
              </label>
              <div class="relative">
                <input
                  class="w-full bg-surface-container-lowest border border-surface-container-highest rounded-lg px-4 py-3 text-body-md font-body-md text-on-surface placeholder:text-outline focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none"
                  id="eventTitle"
                  placeholder="Ej: Bootcamp de Innovación y AgTech 2025: Bioeconomía en la Selva Central"
                  required
                  type="text"
                />
                <span class="material-symbols-outlined absolute right-3.5 top-3.5 text-outline text-xl pointer-events-none">edit</span>
              </div>
              <p class="font-label-sm text-label-sm text-secondary mt-1.5">Un título descriptivo que identifique claramente el objetivo de la convocatoria.</p>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="font-label-lg text-label-lg text-on-surface" for="eventDescription">
                  Descripción detallada del evento <span class="text-error">*</span>
                </label>
                <span class="font-label-sm text-label-sm text-secondary">Formato enriquecido compatible</span>
              </div>
              <div class="border border-surface-container-highest rounded-t-lg bg-surface-container-low px-3 py-2 flex items-center flex-wrap gap-1">
                <button class="p-1.5 rounded hover:bg-surface-variant text-secondary hover:text-on-surface transition-colors" title="Negrita" type="button">
                  <span class="material-symbols-outlined text-base">format_bold</span>
                </button>
                <button class="p-1.5 rounded hover:bg-surface-variant text-secondary hover:text-on-surface transition-colors" title="Cursiva" type="button">
                  <span class="material-symbols-outlined text-base">format_italic</span>
                </button>
                <button class="p-1.5 rounded hover:bg-surface-variant text-secondary hover:text-on-surface transition-colors" title="Lista con viñetas" type="button">
                  <span class="material-symbols-outlined text-base">format_list_bulleted</span>
                </button>
                <button class="p-1.5 rounded hover:bg-surface-variant text-secondary hover:text-on-surface transition-colors" title="Lista numerada" type="button">
                  <span class="material-symbols-outlined text-base">format_list_numbered</span>
                </button>
                <div class="h-4 w-px bg-outline-variant mx-1"></div>
                <button class="p-1.5 rounded hover:bg-surface-variant text-secondary hover:text-on-surface transition-colors" title="Insertar enlace" type="button">
                  <span class="material-symbols-outlined text-base">link</span>
                </button>
                <button class="p-1.5 rounded hover:bg-surface-variant text-secondary hover:text-on-surface transition-colors" title="Cita textual" type="button">
                  <span class="material-symbols-outlined text-base">format_quote</span>
                </button>
              </div>
              <textarea
                class="w-full bg-surface-container-lowest border-x border-b border-surface-container-highest rounded-b-lg px-4 py-3 text-body-md font-body-md text-on-surface placeholder:text-outline focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none resize-y"
                id="eventDescription"
                placeholder="Detalla los objetivos del evento, perfil de los participantes, beneficios, premios o certificación, y etapas de selección..."
                required
                rows="5"
              ></textarea>
            </div>

            <!-- Tags -->
            <div>
              <label class="block font-label-lg text-label-lg text-on-surface mb-2">Etiquetas temáticas (Tags)</label>
              <p class="font-body-sm text-body-sm text-secondary mb-3">Selecciona las categorías predefinidas o agrega tus propias etiquetas.</p>
              <div class="flex flex-wrap gap-2 mb-3" id="quickTagList">
                <button class="tag-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-surface-container-highest bg-surface-container-low hover:bg-surface-container text-secondary text-label-sm font-label-sm transition-all" data-tag="AgTech" type="button">
                  <span class="material-symbols-outlined text-sm">add</span>
                  <span>AgTech</span>
                </button>
                <button class="tag-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-surface-container-highest bg-surface-container-low hover:bg-surface-container text-secondary text-label-sm font-label-sm transition-all" data-tag="FoodTech" type="button">
                  <span class="material-symbols-outlined text-sm">add</span>
                  <span>FoodTech</span>
                </button>
                <button class="tag-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-primary bg-primary/10 text-primary font-bold text-label-sm font-label-sm transition-all" data-tag="Bioeconomía" type="button">
                  <span class="material-symbols-outlined text-sm">check</span>
                  <span>Bioeconomía</span>
                </button>
                <button class="tag-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-primary bg-primary/10 text-primary font-bold text-label-sm font-label-sm transition-all" data-tag="Innovación" type="button">
                  <span class="material-symbols-outlined text-sm">check</span>
                  <span>Innovación</span>
                </button>
                <button class="tag-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-surface-container-highest bg-surface-container-low hover:bg-surface-container text-secondary text-label-sm font-label-sm transition-all" data-tag="Pitch" type="button">
                  <span class="material-symbols-outlined text-sm">add</span>
                  <span>Pitch</span>
                </button>
                <button class="tag-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-surface-container-highest bg-surface-container-low hover:bg-surface-container text-secondary text-label-sm font-label-sm transition-all" data-tag="FinTech" type="button">
                  <span class="material-symbols-outlined text-sm">add</span>
                  <span>FinTech</span>
                </button>
                <button class="tag-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-surface-container-highest bg-surface-container-low hover:bg-surface-container text-secondary text-label-sm font-label-sm transition-all" data-tag="Sostenibilidad" type="button">
                  <span class="material-symbols-outlined text-sm">add</span>
                  <span>Sostenibilidad</span>
                </button>
              </div>

              <div class="flex gap-2">
                <div class="relative flex-grow">
                  <input
                    class="w-full bg-surface-container-lowest border border-surface-container-highest rounded-lg px-4 py-2.5 text-body-sm font-body-sm text-on-surface placeholder:text-outline focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none"
                    id="customTagInput"
                    placeholder="Escribe una nueva etiqueta (ej: Agroforestería, Startups)"
                    type="text"
                  />
                </div>
                <button
                  id="addTagBtn"
                  class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-lg border border-primary text-primary hover:bg-primary hover:text-on-primary font-label-lg text-label-lg transition-colors whitespace-nowrap"
                  type="button"
                >
                  <span class="material-symbols-outlined text-lg">add_circle</span>
                  <span>+ Agregar etiqueta</span>
                </button>
              </div>

              <div class="mt-3 flex flex-wrap gap-2 items-center" id="activeTagsWrapper">
                <span class="font-label-sm text-label-sm text-secondary mr-1">Etiquetas seleccionadas:</span>
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm">
                  Bioeconomía
                  <button class="hover:text-error transition-colors flex items-center remove-tag-btn" type="button">
                    <span class="material-symbols-outlined text-sm">close</span>
                  </button>
                </span>
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm">
                  Innovación
                  <button class="hover:text-error transition-colors flex items-center remove-tag-btn" type="button">
                    <span class="material-symbols-outlined text-sm">close</span>
                  </button>
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. Afiliación / Entidad Convocante -->
        <section class="bg-surface-container-lowest rounded-xl border border-surface-container-highest p-6 lg:p-8 shadow-sm transition-all duration-200 hover:border-outline-variant">
          <div class="flex items-center justify-between pb-5 border-b border-surface-container mb-6">
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-fixed text-primary font-headline-sm text-sm font-bold">2</span>
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Afiliación / Entidad Convocante</h2>
                  <span class="px-2 py-0.5 rounded text-label-sm font-label-sm bg-error-container text-on-error-container font-semibold">Obligatorio</span>
                </div>
                <p class="font-body-sm text-body-sm text-secondary">Debes vincular este evento con al menos una entidad oficial de la UNAS o aliado acreditado.</p>
              </div>
            </div>
            <div class="bg-tertiary-container/10 border border-tertiary-container/30 text-tertiary px-3 py-1.5 rounded-full font-label-sm text-label-sm flex items-center gap-1.5 font-bold" id="affiliationCounter">
              <span class="material-symbols-outlined text-sm">check_circle</span>
              <span id="affiliationCountText">1 entidad seleccionada</span>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="affiliationGrid">
            <label class="affiliation-card cursor-pointer border-2 border-primary bg-primary/5 rounded-xl p-4.5 flex flex-col justify-between transition-all duration-200 hover:shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-surface-container-lowest border border-surface-container-highest flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-2xl">rocket_launch</span>
                  </div>
                  <div>
                    <h3 class="font-label-lg text-label-lg font-bold text-on-surface">IncubaUNAS</h3>
                    <span class="text-label-sm font-label-sm text-primary font-semibold">Incubadora Oficial</span>
                  </div>
                </div>
                <input checked class="rounded text-primary focus:ring-primary h-5 w-5 border-outline-variant affiliation-checkbox" name="affiliation" type="checkbox" value="IncubaUNAS" />
              </div>
              <p class="font-body-sm text-body-sm text-secondary mt-3">Dirección de Innovación y Transferencia Tecnológica - UNAS.</p>
            </label>

            <label class="affiliation-card cursor-pointer border border-surface-container-highest bg-surface-container-lowest rounded-xl p-4.5 flex flex-col justify-between transition-all duration-200 hover:border-primary/50">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-surface-container-lowest border border-surface-container-highest flex items-center justify-center text-tertiary">
                    <span class="material-symbols-outlined text-2xl">school</span>
                  </div>
                  <div>
                    <h3 class="font-label-lg text-label-lg font-bold text-on-surface">Facultad / Dpto. UNAS</h3>
                    <span class="text-label-sm font-label-sm text-secondary">Agronomía / RRNN / Zootecnia</span>
                  </div>
                </div>
                <input class="rounded text-primary focus:ring-primary h-5 w-5 border-outline-variant affiliation-checkbox" name="affiliation" type="checkbox" value="Facultad_UNAS" />
              </div>
              <p class="font-body-sm text-body-sm text-secondary mt-3">Facultad de Agronomía, Recursos Naturales Renovables o Ingeniería.</p>
            </label>

            <label class="affiliation-card cursor-pointer border border-surface-container-highest bg-surface-container-lowest rounded-xl p-4.5 flex flex-col justify-between transition-all duration-200 hover:border-primary/50">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-surface-container-lowest border border-surface-container-highest flex items-center justify-center text-on-secondary-variant">
                    <span class="material-symbols-outlined text-2xl">account_balance</span>
                  </div>
                  <div>
                    <h3 class="font-label-lg text-label-lg font-bold text-on-surface">ProInnóvate Perú</h3>
                    <span class="text-label-sm font-label-sm text-secondary">Ministerio de la Producción</span>
                  </div>
                </div>
                <input class="rounded text-primary focus:ring-primary h-5 w-5 border-outline-variant affiliation-checkbox" name="affiliation" type="checkbox" value="ProInnovate" />
              </div>
              <p class="font-body-sm text-body-sm text-secondary mt-3">Programas de co-financiamiento y fondos concursables nacionales.</p>
            </label>

            <label class="affiliation-card cursor-pointer border border-surface-container-highest bg-surface-container-lowest rounded-xl p-4.5 flex flex-col justify-between transition-all duration-200 hover:border-primary/50">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-surface-container-lowest border border-surface-container-highest flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-2xl">groups</span>
                  </div>
                  <div>
                    <h3 class="font-label-lg text-label-lg font-bold text-on-surface">Círculos de Investigación</h3>
                    <span class="text-label-sm font-label-sm text-secondary">Comunidad Estudiantil</span>
                  </div>
                </div>
                <input class="rounded text-primary focus:ring-primary h-5 w-5 border-outline-variant affiliation-checkbox" name="affiliation" type="checkbox" value="Circulo_Estudiantil" />
              </div>
              <p class="font-body-sm text-body-sm text-secondary mt-3">Grupos semilleros de investigación, robótica y emprendimiento UNAS.</p>
            </label>

            <label class="affiliation-card cursor-pointer border border-surface-container-highest bg-surface-container-lowest rounded-xl p-4.5 flex flex-col justify-between transition-all duration-200 hover:border-primary/50">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-surface-container-lowest border border-surface-container-highest flex items-center justify-center text-tertiary">
                    <span class="material-symbols-outlined text-2xl">handshake</span>
                  </div>
                  <div>
                    <h3 class="font-label-lg text-label-lg font-bold text-on-surface">Aliado Estratégico Externo</h3>
                    <span class="text-label-sm font-label-sm text-secondary">Empresas & Cooperativas</span>
                  </div>
                </div>
                <input class="rounded text-primary focus:ring-primary h-5 w-5 border-outline-variant affiliation-checkbox" name="affiliation" type="checkbox" value="Aliado_Externo" />
              </div>
              <p class="font-body-sm text-body-sm text-secondary mt-3">Cooperativas agrarias de Tingo María, gremios cafetaleros o cacao.</p>
            </label>

            <div class="border border-dashed border-outline-variant rounded-xl p-4.5 flex flex-col justify-center items-center text-center bg-surface-container-low/50 hover:bg-surface-container-low transition-colors">
              <span class="material-symbols-outlined text-outline text-3xl mb-1">domain_add</span>
              <div class="font-label-lg text-label-lg font-semibold text-on-surface">¿Otra entidad o convenio?</div>
              <p class="font-body-sm text-body-sm text-secondary mt-1 mb-2">Especifica instituciones en observaciones.</p>
              <button class="text-primary hover:underline font-label-sm text-label-sm font-bold flex items-center gap-1" type="button">
                <span>+ Especificar convenio</span>
              </button>
            </div>
          </div>
          <p class="hidden text-error font-label-sm text-label-sm mt-3 flex items-center gap-1.5" id="affiliationAlert">
            <span class="material-symbols-outlined text-base">error</span> Debes seleccionar al menos una entidad o afiliación antes de publicar.
          </p>
        </section>

        <!-- 3. Sesiones y Cronograma -->
        <section class="bg-surface-container-lowest rounded-xl border border-surface-container-highest p-6 lg:p-8 shadow-sm transition-all duration-200 hover:border-outline-variant">
