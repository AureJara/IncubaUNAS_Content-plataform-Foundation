---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión | IncubaUNAS" activeNav="acceder">
  <div class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 relative overflow-hidden">
    <!-- Fondos atmosféricos y geometría sutil -->
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-tertiary/5 blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl mx-auto relative z-10">
      <!-- Contenedor / Tarjeta de Autenticación -->
      <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl shadow-[0_4px_24px_rgba(13,27,42,0.06)] overflow-hidden">
        <!-- Banda superior de estatus institucional -->
        <div class="h-1.5 w-full bg-gradient-to-r from-primary via-primary-container to-tertiary"></div>

        <div class="p-6 sm:p-10">
          <!-- Cabecera de la Tarjeta -->
          <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center p-2 mb-4 rounded-xl bg-surface-container-low border border-surface-container-high">
              <img
                alt="IncubaUNAS"
                class="h-8 w-auto"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBrm0CPY_D60P05qToSRT3nzs_biORYbBdOM4ERJLTGQJlzcrJxfHanXKrc2tr9PKpKXSY2I-WdgjgOomM9QompiqzpgHONGTOPodemUbyk-uXReSP3LLPNJFa7uZ_kJBVR8idgwAJ8LqtaxLB2PBCrc4QOaee0ENSQYddQqJOCnhYr6p-SgnARQr7dMiK8PKRx2vZObDluq0bMVxk6qdNmGqeSgyACzpJjnhoU2orWgh1PGSFquFV2"
              />
            </div>
            <h1 class="text-headline-md font-headline-md text-on-surface mb-2 tracking-tight">Iniciar Sesión</h1>
            <p class="text-body-md font-body-md text-secondary">
              Selecciona tu tipo de perfil para acceder a tus recursos e incubación.
            </p>
          </div>

          <!-- SELECTOR DE TIPO DE USUARIO / ROL -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-2.5">
              <label class="text-label-md font-label-md text-on-surface uppercase tracking-wider font-bold">
                Tipo de Usuario <span class="text-primary">*</span>
              </label>
              <span id="role-indicator-badge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-primary-fixed text-primary">
                Gestión Institucional
              </span>
            </div>

            <!-- Grid de 3 roles con botones interactivos -->
            <div aria-label="Selecciona tu rol" class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" role="radiogroup">
              <!-- Rol 1: Participante -->
              <button
                aria-checked="false"
                class="role-card flex flex-col items-center justify-center p-3.5 rounded-lg text-secondary transition-all text-center group cursor-pointer relative border border-surface-container-highest bg-surface-container-lowest"
                id="role-btn-participante"
                type="button"
              >
                <div class="w-10 h-10 rounded-full flex items-center justify-center mb-2 group-hover:scale-110 transition-transform bg-surface-container-high text-secondary">
                  <span class="material-symbols-outlined text-[22px]">rocket_launch</span>
                </div>
                <span class="text-label-lg font-label-lg text-on-surface block leading-tight font-semibold">Participante</span>
              </button>

              <!-- Rol 2: Personal de apoyo -->
              <button
                aria-checked="false"
                class="role-card flex flex-col items-center justify-center p-3.5 rounded-lg text-secondary hover:border-outline-variant transition-all text-center group cursor-pointer relative border border-surface-container-highest bg-surface-container-lowest"
                id="role-btn-apoyo"
                type="button"
              >
                <div class="w-10 h-10 rounded-full flex items-center justify-center mb-2 group-hover:scale-110 transition-transform bg-surface-container-high text-secondary">
                  <span class="material-symbols-outlined text-[22px]">supervisor_account</span>
                </div>
                <span class="text-label-lg font-label-lg text-on-surface block leading-tight font-semibold">Staff / Personal</span>
              </button>

              <!-- Rol 3: Organizador (Default Seleccionado) -->
              <button
                aria-checked="true"
                class="role-card flex flex-col items-center justify-center p-3.5 rounded-lg text-on-surface transition-all text-center group cursor-pointer relative border-2 border-primary bg-primary-fixed/20 shadow-sm"
                id="role-btn-organizador"
                type="button"
              >
                <div class="w-10 h-10 rounded-full flex items-center justify-center mb-2 group-hover:scale-110 transition-transform bg-primary/10 text-primary">
                  <span class="material-symbols-outlined text-[22px]">admin_panel_settings</span>
                </div>
                <span class="text-label-lg font-label-lg text-on-surface block leading-tight font-bold">Organizador</span>
                <span class="absolute top-1.5 right-1.5 flex h-2 w-2">
                  <span class="role-dot animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                  <span class="role-dot-static relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                </span>
              </button>
            </div>

            <!-- Banner contextual informativo del rol -->
            <div class="mt-3 p-3 rounded-lg bg-surface-container-low border border-surface-container-high flex items-start gap-2.5 transition-all" id="role-context-banner">
              <span class="material-symbols-outlined text-primary text-[20px] mt-0.5 flex-shrink-0">info</span>
              <p class="text-body-sm font-body-sm text-secondary" id="role-context-text">
                Panel de administración global, comités evaluadores y fiscalización UNAS.
              </p>
            </div>
          </div>

          <!-- Formulario de Acceso -->
          <form class="space-y-4" onsubmit="event.preventDefault(); window.location.href='/convocar/crear';">
            <!-- Campo: Correo Electrónico -->
            <div>
              <label class="block text-label-md font-label-md text-on-surface mb-1.5" for="email-input">
                Correo electrónico institucional o personal
              </label>
              <div class="relative rounded-lg shadow-sm">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-secondary">
                  <span class="material-symbols-outlined text-[20px]">alternate_email</span>
                </div>
                <input
                  class="block w-full pl-10 pr-3.5 py-2.5 rounded-lg border border-surface-container-highest bg-surface-container-lowest text-on-surface text-body-md font-body-md placeholder:text-outline focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                  id="email-input"
                  placeholder="admin.incuba@unas.edu.pe"
                  required
                  type="email"
                />
              </div>
            </div>

            <!-- Campo: Contraseña -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block text-label-md font-label-md text-on-surface" for="password-input">
                  Contraseña
                </label>
                <a class="text-label-sm font-label-sm font-semibold text-primary hover:text-primary-container transition-colors" href="#">
                  ¿Olvidaste tu contraseña?
                </a>
              </div>
              <div class="relative rounded-lg shadow-sm">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-secondary">
                  <span class="material-symbols-outlined text-[20px]">lock</span>
                </div>
                <input
                  class="block w-full pl-10 pr-10 py-2.5 rounded-lg border border-surface-container-highest bg-surface-container-lowest text-on-surface text-body-md font-body-md placeholder:text-outline focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                  id="password-input"
                  placeholder="••••••••••••"
                  required
                  type="password"
                />
                <button
                  id="toggle-pwd-btn"
                  class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-secondary hover:text-on-surface focus:outline-none"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[20px]" id="password-toggle-icon">visibility</span>
                </button>
              </div>
            </div>

            <!-- Checkbox: Recordar Sesión -->
            <div class="flex items-center justify-between pt-1">
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input checked class="w-4 h-4 rounded text-primary focus:ring-primary border-surface-container-highest bg-surface-container-lowest transition-colors" type="checkbox" />
                <span class="text-body-sm font-body-sm text-secondary">Recordar mi sesión en este equipo</span>
              </label>
            </div>

            <!-- Botón Primario de Ingreso -->
            <div class="pt-2">
              <button
                class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-primary-container text-on-primary-container font-label-lg text-label-lg font-bold shadow-md hover:brightness-105 active:scale-[0.99] transition-all"
                id="submit-login-button"
                type="submit"
              >
                <span class="material-symbols-outlined text-[20px]">login</span>
                <span id="submit-button-text">Ingresar como Organizador</span>
              </button>
            </div>
          </form>

          <!-- Divisor institucional -->
          <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-surface-container-highest"></div>
            </div>
            <div class="relative flex justify-center text-label-sm font-label-sm">
              <span class="px-3 bg-surface-container-lowest text-secondary uppercase font-semibold">O ingresa mediante</span>
            </div>
          </div>

          <!-- Acceso con Google Institucional (@unas.edu.pe) -->
          <button
            class="w-full flex items-center justify-center gap-3 py-2.5 px-4 rounded-lg border border-surface-container-highest bg-surface-container-lowest hover:bg-surface-container-low text-on-surface font-label-lg text-label-lg font-semibold transition-all shadow-sm"
            type="button"
          >
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24">
              <path d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.15z" fill="#4285F4"></path>
              <path d="M12 24c3.24 0 5.95-1.08 7.93-2.92l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z" fill="#34A853"></path>
              <path d="M5.28 14.26c-.25-.72-.38-1.49-.38-2.26s.13-1.54.38-2.26V6.59H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.41l4.03-3.15z" fill="#FBBC05"></path>
              <path d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.59l4.03 3.15c.95-2.83 3.6-4.99 6.72-4.99z" fill="#EA4335"></path>
            </svg>
            <span>Cuenta Google Institucional (@unas.edu.pe)</span>
          </button>

          <!-- Registro y Postulación para Nuevos Usuarios -->
          <div class="mt-8 text-center pt-5 border-t border-surface-container-high">
            <p class="text-body-sm font-body-sm text-secondary">
              ¿No tienes una cuenta de emprendedor?
              <a class="font-bold text-primary hover:text-primary-container transition-colors ml-1 inline-flex items-center gap-0.5" href="/convocar">
                Regístrate o Postula aquí
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
            </p>
          </div>
        </div>
      </div>

      <!-- Ayuda técnica o de soporte -->
      <div class="mt-4 flex items-center justify-center gap-6 text-label-sm font-label-sm text-secondary">
        <a class="hover:text-on-surface transition-colors flex items-center gap-1" href="#">
          <span class="material-symbols-outlined text-[16px]">help</span>
          Mesa de ayuda
        </a>
        <span>•</span>
        <a class="hover:text-on-surface transition-colors flex items-center gap-1" href="#">
          <span class="material-symbols-outlined text-[16px]">verified_user</span>
          Acceso seguro SSL
        </a>
        <span>•</span>
        <a class="hover:text-on-surface transition-colors flex items-center gap-1" href="mailto:incubadora@unas.edu.pe">
          <span class="material-symbols-outlined text-[16px]">mail</span>
          incubadora@unas.edu.pe
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  interface RoleConfig {
    label: string;
    placeholder: string;
    context: string;
    badge: string;
  }

  const roleConfigs: Record<string, RoleConfig> = {
    participante: {
      label: 'Participante',
      placeholder: 'usuario@unas.edu.pe o registrado',
      context: 'Acceso a convocatorias, workshops, perfil de startup y postulación activa.',
      badge: 'Acceso Emprendedor'
    },
    apoyo: {
      label: 'Personal de apoyo',
      placeholder: 'mentor@unas.edu.pe o asignado',
      context: 'Gestión de mentorías agendadas, retroalimentación y evaluaciones técnicas.',
      badge: 'Acceso Mentor & Staff'
    },
    organizador: {
      label: 'Organizador',
      placeholder: 'admin.incuba@unas.edu.pe',
      context: 'Panel de administración global, comités evaluadores y fiscalización UNAS.',
      badge: 'Gestión Institucional'
    }
  };

  const roles = ['participante', 'apoyo', 'organizador'];

  function selectRole(roleId: string) {
    const config = roleConfigs[roleId];
    if (!config) return;

    roles.forEach((r) => {
      const btn = document.getElementById(`role-btn-${r}`);
      if (!btn) return;
      const iconContainer = btn.querySelector('div');
      const titleSpan = btn.querySelector('span.text-label-lg');
      const pingIndicator = btn.querySelector('span.absolute');

      if (r === roleId) {
        btn.classList.add('border-2', 'border-primary', 'bg-primary-fixed/20', 'shadow-sm');
        btn.classList.remove('border-surface-container-highest', 'bg-surface-container-lowest', 'border');
        btn.setAttribute('aria-checked', 'true');

        if (iconContainer) {
          iconContainer.classList.add('bg-primary/10', 'text-primary');
          iconContainer.classList.remove('bg-surface-container-high', 'text-secondary');
        }

        if (titleSpan) {
          titleSpan.classList.add('font-bold');
          titleSpan.classList.remove('font-semibold');
        }

        if (!pingIndicator) {
          const badgeIndicator = document.createElement('span');
          badgeIndicator.className = 'absolute top-1.5 right-1.5 flex h-2 w-2';
          badgeIndicator.innerHTML = `
            <span class="role-dot animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="role-dot-static relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          `;
          btn.appendChild(badgeIndicator);
        }
      } else {
        btn.classList.remove('border-2', 'border-primary', 'bg-primary-fixed/20', 'shadow-sm');
        btn.classList.add('border', 'border-surface-container-highest', 'bg-surface-container-lowest');
        btn.setAttribute('aria-checked', 'false');

        if (iconContainer) {
          iconContainer.classList.remove('bg-primary/10', 'text-primary');
          iconContainer.classList.add('bg-surface-container-high', 'text-secondary');
        }

        if (titleSpan) {
          titleSpan.classList.remove('font-bold');
          titleSpan.classList.add('font-semibold');
        }

        if (pingIndicator) {
          pingIndicator.remove();
        }
      }
    });

    const submitText = document.getElementById('submit-button-text');
    if (submitText) submitText.textContent = `Ingresar como ${config.label}`;

    const emailInput = document.getElementById('email-input') as HTMLInputElement | null;
    if (emailInput) emailInput.placeholder = config.placeholder;

    const contextText = document.getElementById('role-context-text');
    if (contextText) contextText.textContent = config.context;

    const roleBadge = document.getElementById('role-indicator-badge');
    if (roleBadge) roleBadge.textContent = config.badge;
  }

  document.addEventListener('DOMContentLoaded', () => {
    roles.forEach((r) => {
      const btn = document.getElementById(`role-btn-${r}`);
      if (btn) {
        btn.addEventListener('click', () => selectRole(r));
      }
    });

    const toggleBtn = document.getElementById('toggle-pwd-btn');
    const pwdInput = document.getElementById('password-input') as HTMLInputElement | null;
    const toggleIcon = document.getElementById('password-toggle-icon');

    if (toggleBtn && pwdInput && toggleIcon) {
      toggleBtn.addEventListener('click', () => {
        if (pwdInput.type === 'password') {
          pwdInput.type = 'text';
          toggleIcon.textContent = 'visibility_off';
        } else {
          pwdInput.type = 'password';
          toggleIcon.textContent = 'visibility';
        }
      });
    }
  });
</script>
