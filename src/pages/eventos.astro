---

<Layout title="Eventos y Convocatorias | IncubaUNAS" activeNav="eventos">
  <!-- HERO & SEARCH BAR -->
  <section class="relative bg-surface border-b border-surface-container-highest/60 overflow-hidden py-12 lg:py-16">
    <div class="absolute -top-24 right-0 w-96 h-96 bg-primary-fixed/30 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 left-0 w-80 h-80 bg-tertiary-fixed/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="max-w-3xl mb-8">
        <h1 class="font-headline-lg md:font-display text-headline-lg-mobile md:text-headline-lg font-bold text-on-surface tracking-tight mb-4">
          Eventos y Convocatorias
        </h1>
        <p class="font-body-lg text-body-md md:text-body-lg text-secondary max-w-2xl leading-relaxed">
          Descubre talleres, conferencias, demo days y bootcamps diseñados para fortalecer el ecosistema emprendedor e innovador de la Amazonía peruana.
        </p>
      </div>

      <!-- Comprehensive Event Search Container -->
      <div class="bg-surface-container-lowest rounded-xl border border-surface-container-highest shadow-sm p-4 lg:p-6 mb-6">
        <form class="grid grid-cols-1 md:grid-cols-12 gap-3" onsubmit="event.preventDefault();">
          <!-- Keyword Search -->
          <div class="md:col-span-5 relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline" data-icon="search">search</span>
            <input
              id="event-search"
              class="w-full pl-11 pr-4 py-3 rounded-lg border border-surface-container-highest bg-surface-container-lowest text-on-surface placeholder:text-outline text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none"
              placeholder="Buscar por nombre, ponente, tema o palabra clave..."
              type="text"
            />
          </div>

          <!-- Category Selector -->
          <div class="md:col-span-3 relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline" data-icon="category">category</span>
            <select
              id="event-category"
              class="w-full pl-11 pr-8 py-3 rounded-lg border border-surface-container-highest bg-surface-container-lowest text-on-surface text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none appearance-none cursor-pointer"
            >
              <option value="">Todas las categorías</option>
              <option value="bionegocios">Bionegocios & Startups</option>
              <option value="propiedad">Propiedad Intelectual</option>
              <option value="agtech">AgTech & IoT</option>
              <option value="comunidad">Comunidad & Redes</option>
              <option value="financiamiento">Financiamiento & Fondos</option>
              <option value="circular">Economía Circular</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none" data-icon="expand_more">expand_more</span>
          </div>

          <!-- Modality Selector -->
          <div class="md:col-span-2 relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline" data-icon="location_on">location_on</span>
            <select
              id="event-modality"
              class="w-full pl-11 pr-8 py-3 rounded-lg border border-surface-container-highest bg-surface-container-lowest text-on-surface text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none appearance-none cursor-pointer"
            >
              <option value="">Modalidad</option>
              <option value="presencial">Presencial (Campus UNAS)</option>
              <option value="virtual">Virtual</option>
              <option value="hibrido">Híbrido</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none" data-icon="expand_more">expand_more</span>
          </div>

          <!-- Submit Button -->
          <div class="md:col-span-2">
            <button
              id="search-btn"
              class="w-full h-full min-h-[46px] px-6 py-3 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 transition-all duration-150 shadow-sm active:scale-95"
              type="button"
            >
              <span class="material-symbols-outlined text-lg" data-icon="filter_list">filter_list</span>
              <span>Buscar</span>
            </button>
          </div>
        </form>

        <!-- Quick Filters Pills -->
        <div class="flex items-center gap-2 pt-4 mt-4 border-t border-surface-container overflow-x-auto no-scrollbar text-label-md">
          <span class="text-secondary font-medium mr-1 flex items-center gap-1 shrink-0">
            <span class="material-symbols-outlined text-sm" data-icon="label">label</span>
            Filtro rápido:
          </span>
          <button class="pill-btn px-3.5 py-1.5 rounded-full bg-on-surface text-surface-container-lowest font-medium transition-all shrink-0" data-pill="all">
            Todos
          </button>
          <button class="pill-btn px-3.5 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant transition-colors shrink-0" data-pill="bootcamp">
            Próximos bootcamps
          </button>
          <button class="pill-btn px-3.5 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant transition-colors shrink-0" data-pill="taller">
            Talleres gratuitos
          </button>
          <button class="pill-btn px-3.5 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant transition-colors shrink-0" data-pill="demo">
            Demo Days
          </button>
          <button class="pill-btn px-3.5 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant transition-colors shrink-0" data-pill="hackathon">
            Ideatones / Hackathons
          </button>
        </div>
      </div>

      <!-- Meta status row -->
      <div class="flex flex-wrap items-center justify-between text-body-sm text-secondary gap-4">
        <p>Mostrando <span class="font-semibold text-on-surface">6 eventos activos</span> para la comunidad UNAS y la región Huánuco</p>
        <div class="flex items-center gap-3">
          <span class="text-outline">Ordenar por:</span>
          <select class="bg-transparent border-0 text-on-surface font-semibold text-body-sm focus:ring-0 cursor-pointer p-0">
            <option>Más recientes primero</option>
            <option>Fecha del evento (Próximos)</option>
            <option>Mayor cupo disponible</option>
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- EVENTS GRID SECTION -->
  <section class="max-w-7xl mx-auto px-6 lg:px-12 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="events-grid">
      {events.map((ev) => (
        <article class="event-card flex flex-col bg-surface-container-lowest rounded-xl border border-surface-container-highest overflow-hidden hover:border-outline-variant hover:shadow-lg transition-all duration-200 group">
          <!-- Thumbnail Header with badges -->
          <div class="relative aspect-video w-full overflow-hidden bg-surface-container">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              src={ev.imageUrl}
              alt={ev.imageAlt}
            />
            <div class="absolute top-3 left-3 flex flex-wrap gap-2">
              <span class="px-2.5 py-1 rounded-md bg-surface-container-lowest/90 backdrop-blur-sm text-primary font-bold text-label-sm uppercase tracking-wider shadow-sm">
                {ev.date}
              </span>
              <span class={`px-2.5 py-1 rounded-md ${ev.modalityClass} font-semibold text-label-sm shadow-sm flex items-center gap-1`}>
                <span class="material-symbols-outlined text-xs" data-icon="check_circle">check_circle</span>
                {ev.modalityBadge}
              </span>
            </div>
            <div class="absolute bottom-3 left-3">
              <span class="px-2.5 py-1 rounded-full bg-inverse-surface/80 text-inverse-on-surface text-label-sm font-medium backdrop-blur-sm">
                {ev.location}
              </span>
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class={`font-label-sm text-label-sm font-bold uppercase tracking-wider ${ev.categoryColor}`}>
                  {ev.category}
                </span>
                <span class={`inline-flex items-center text-label-sm font-semibold gap-1 px-2 py-0.5 rounded-full ${ev.tagClass}`}>
                  <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
                  {ev.tag}
                </span>
              </div>
              <h2 class="font-title text-headline-sm font-bold text-on-surface group-hover:text-primary transition-colors leading-snug mb-3">
                {ev.title}
              </h2>
              <p class="font-body-sm text-body-sm text-secondary line-clamp-3 mb-4">
                {ev.description}
              </p>
            </div>

            <!-- Metadata specs -->
            <div class="space-y-3 pt-3 border-t border-surface-container">
              <div class="grid grid-cols-2 gap-2 text-label-md text-secondary">
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-base text-outline" data-icon="schedule">schedule</span>
                  <span>{ev.schedule}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-base text-outline" data-icon={ev.highlightIcon}>{ev.highlightIcon}</span>
                  <span>{ev.highlightText}</span>
                </div>
              </div>

              <!-- Speaker / Partner Info -->
              <div class="flex items-center gap-2.5 py-1">
                <div class={`w-7 h-7 rounded-full ${ev.speakerBg} flex items-center justify-center ${ev.speakerText} font-bold text-label-sm`}>
                  {ev.speakerInitials}
                </div>
                <div class="text-body-sm truncate">
                  <span class="font-semibold text-on-surface block truncate">{ev.speakerName}</span>
                  <span class="text-outline text-label-sm block truncate">{ev.speakerRole}</span>
                </div>
              </div>

              <div class="pt-2 flex items-center justify-between gap-3">
                <span class={`text-label-sm flex items-center gap-1 ${ev.seatsClass}`}>
                  <span class="material-symbols-outlined text-sm" data-icon={ev.seatsIcon}>{ev.seatsIcon}</span>
                  {ev.seatsText}
                </span>
                <a
                  href="/acceder"
                  class="px-4 py-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-semibold transition-all duration-150 active:scale-95 shadow-sm inline-block"
                >
                  Inscribirme
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- PAGINATION -->
    <div class="mt-12 flex items-center justify-between border-t border-surface-container pt-6">
      <p class="text-body-sm text-secondary">
        Mostrando página <span class="font-semibold text-on-surface">1</span> de <span class="font-semibold text-on-surface">4</span>
      </p>
      <nav class="flex items-center gap-1.5">
        <button class="p-2 rounded-lg border border-surface-container-highest text-outline hover:text-on-surface hover:bg-surface-container disabled:opacity-40 transition-colors" disabled>
          <span class="material-symbols-outlined text-lg" data-icon="chevron_left">chevron_left</span>
        </button>
        <button class="w-9 h-9 rounded-lg bg-primary text-on-primary font-semibold text-label-md flex items-center justify-center shadow-sm">
          1
        </button>
        <button class="w-9 h-9 rounded-lg border border-surface-container-highest text-secondary hover:bg-surface-container hover:text-on-surface font-semibold text-label-md flex items-center justify-center transition-colors">
          2
        </button>
        <button class="w-9 h-9 rounded-lg border border-surface-container-highest text-secondary hover:bg-surface-container hover:text-on-surface font-semibold text-label-md flex items-center justify-center transition-colors">
          3
        </button>
        <span class="px-1 text-outline">...</span>
        <button class="w-9 h-9 rounded-lg border border-surface-container-highest text-secondary hover:bg-surface-container hover:text-on-surface font-semibold text-label-md flex items-center justify-center transition-colors">
          4
        </button>
        <button class="p-2 rounded-lg border border-surface-container-highest text-secondary hover:text-on-surface hover:bg-surface-container transition-colors">
          <span class="material-symbols-outlined text-lg" data-icon="chevron_right">chevron_right</span>
        </button>
      </nav>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('event-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.event-card');
    const pillButtons = document.querySelectorAll<HTMLButtonElement>('.pill-btn');

    function filterEvents(query: string) {
      cards.forEach((card) => {
        const text = card.textContent?.toLowerCase() || '';
        if (text.includes(query.toLowerCase())) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        filterEvents((e.target as HTMLInputElement).value.trim());
      });
    }

    pillButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        pillButtons.forEach((b) => {
          b.classList.remove('bg-on-surface', 'text-surface-container-lowest');
          b.classList.add('bg-surface-container-low', 'text-on-surface-variant');
        });
        btn.classList.remove('bg-surface-container-low', 'text-on-surface-variant');
        btn.classList.add('bg-on-surface', 'text-surface-container-lowest');

        const pill = btn.getAttribute('data-pill');
        if (pill === 'all') {
          filterEvents('');
        } else if (pill === 'bootcamp') {
          filterEvents('bootcamp');
        } else if (pill === 'taller') {
          filterEvents('taller');
        } else if (pill === 'demo') {
          filterEvents('demo day');
        } else if (pill === 'hackathon') {
          filterEvents('ideatón');
        }
      });
    });
  });
</script>
