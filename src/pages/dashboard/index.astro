---
import Layout from '../../layouts/Layout.astro';
import DashboardSidebar from '../../components/DashboardSidebar.astro';
---

<Layout title="Panel Principal | IncubaUNAS" activeNav="convocar">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex flex-col lg:flex-row gap-8 items-start">
    <DashboardSidebar activeItem="principal" />

    <!-- MAIN DASHBOARD CONTENT -->
    <div class="flex-1 min-w-0 w-full space-y-8">
      <!-- Welcome Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-surface-container-lowest border border-surface-container-highest p-6 rounded-xl shadow-sm">
        <div>
          <div class="flex items-center gap-2 text-label-sm font-label-sm text-secondary uppercase tracking-wider mb-1">
            <span>Universidad Nacional Agraria de la Selva</span>
            <span>•</span>
            <span class="text-tertiary font-bold flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
              Ciclo Académico 2025-I
            </span>
          </div>
          <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">
            ¡Hola, Carlos Pérez! 👋
          </h1>
          <p class="font-body-md text-body-md text-secondary mt-1">
            Gestión operativa de convocatorias, postulaciones y semilleros de innovación de IncubaUNAS.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/dashboard/postulantes"
            class="px-4 py-2.5 rounded-lg border border-surface-container-highest bg-surface-container-low hover:bg-surface-variant text-on-surface font-label-lg text-label-lg font-semibold transition-all flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-lg text-secondary">inbox</span>
            <span>Postulantes</span>
            <span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container text-xs font-bold">14</span>
          </a>
          <a
            href="/dashboard/crear"
            class="px-5 py-2.5 rounded-lg bg-primary hover:bg-surface-tint text-on-primary font-label-lg text-label-lg font-bold shadow-sm transition-all duration-150 active:scale-95 flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-lg">add_circle</span>
            <span>+ Crear Convocatoria</span>
          </a>
        </div>
      </div>

      <!-- KPI Metrics Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1 -->
        <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-outline-variant transition-colors">
          <div class="flex items-center justify-between mb-3">
            <span class="text-label-sm font-label-sm text-secondary uppercase tracking-wider font-semibold">Convocatorias</span>
            <div class="w-9 h-9 rounded-lg bg-primary-fixed text-primary flex items-center justify-center">
              <span class="material-symbols-outlined text-xl">event_available</span>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-headline-md font-bold text-on-surface">4</span>
            <span class="text-body-sm font-body-sm text-tertiary font-medium">Activas</span>
          </div>
          <div class="mt-2 text-body-sm font-body-sm text-secondary flex items-center justify-between">
            <span>2 en borrador</span>
            <span class="text-xs text-primary font-semibold hover:underline cursor-pointer">
              <a href="/dashboard/convocatorias">Ver todas →</a>
            </span>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-outline-variant transition-colors">
          <div class="flex items-center justify-between mb-3">
            <span class="text-label-sm font-label-sm text-secondary uppercase tracking-wider font-semibold">Postulaciones</span>
            <div class="w-9 h-9 rounded-lg bg-tertiary-fixed text-tertiary flex items-center justify-center">
              <span class="material-symbols-outlined text-xl">how_to_reg</span>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-headline-md font-bold text-on-surface">142</span>
            <span class="text-body-sm font-body-sm text-tertiary font-semibold flex items-center">
              <span class="material-symbols-outlined text-sm">trending_up</span> +34%
            </span>
          </div>
          <div class="mt-2 text-body-sm font-body-sm text-secondary flex items-center justify-between">
            <span class="text-error font-medium">14 por revisar</span>
            <span class="text-xs text-primary font-semibold hover:underline cursor-pointer">
              <a href="/dashboard/postulantes">Revisar →</a>
            </span>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-outline-variant transition-colors">
          <div class="flex items-center justify-between mb-3">
            <span class="text-label-sm font-label-sm text-secondary uppercase tracking-wider font-semibold">Startups Incubadas</span>
            <div class="w-9 h-9 rounded-lg bg-secondary-fixed text-secondary flex items-center justify-center">
              <span class="material-symbols-outlined text-xl">rocket_launch</span>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-headline-md font-bold text-on-surface">28</span>
            <span class="text-body-sm font-body-sm text-secondary">en cartera</span>
          </div>
          <div class="mt-2 text-body-sm font-body-sm text-secondary flex items-center justify-between">
            <span>S/ 1.45M fondos</span>
            <span class="text-xs text-primary font-semibold hover:underline cursor-pointer">
              <a href="/dashboard/participaciones">Portafolio →</a>
            </span>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-outline-variant transition-colors">
          <div class="flex items-center justify-between mb-3">
            <span class="text-label-sm font-label-sm text-secondary uppercase tracking-wider font-semibold">Mentores & Staff</span>
            <div class="w-9 h-9 rounded-lg bg-primary-fixed text-primary flex items-center justify-center">
              <span class="material-symbols-outlined text-xl">group</span>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-headline-md font-bold text-on-surface">18</span>
            <span class="text-body-sm font-body-sm text-tertiary font-medium">Activos</span>
          </div>
          <div class="mt-2 text-body-sm font-body-sm text-secondary flex items-center justify-between">
            <span>6 jurados externos</span>
            <span class="text-xs text-primary font-semibold hover:underline cursor-pointer">
              <a href="/dashboard/equipo">Equipo →</a>
            </span>
          </div>
        </div>
      </div>

      <!-- Main Columns: Content left (2/3), Activity right (1/3) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left: Active Convocatorias & Recent Applicants (8 cols) -->
        <div class="lg:col-span-8 space-y-8">
          <!-- Active Convocatorias Section -->
          <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-sm">
            <div class="flex items-center justify-between pb-4 border-b border-surface-container mb-5">
              <div>
                <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">Convocatorias en Gestión</h2>
                <p class="font-body-sm text-body-sm text-secondary">Programas y bootcamps actualmente abiertos o en proceso de selección.</p>
              </div>
              <a href="/dashboard/convocatorias" class="text-primary hover:underline text-label-sm font-label-sm font-bold flex items-center gap-1">
                <span>Ver todas</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </a>
            </div>

            <div class="space-y-4">
              <!-- Item 1 -->
              <div class="border border-surface-container-highest rounded-xl p-4.5 bg-surface-bright hover:border-primary/50 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-3">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class="px-2 py-0.5 rounded text-xs font-bold bg-tertiary/10 text-tertiary">Inscripción Abierta</span>
                      <span class="text-xs text-secondary font-medium">• Cierra en 12 días</span>
                    </div>
                    <h3 class="font-title text-title font-bold text-on-surface">
                      Bootcamp de Innovación y AgTech 2025: Bioeconomía en la Selva Central
                    </h3>
                  </div>
                  <a
                    href="/dashboard/postulantes"
                    class="self-start sm:self-auto px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-surface-container-highest text-primary hover:bg-primary hover:text-on-primary text-label-sm font-label-sm font-semibold transition-colors flex items-center gap-1.5 whitespace-nowrap"
                  >
                    <span class="material-symbols-outlined text-base">how_to_reg</span>
                    <span>48 Postulantes</span>
                  </a>
                </div>

                <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-body-sm font-body-sm text-secondary pt-2 border-t border-surface-container">
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-base text-primary">calendar_month</span>
                    18 Abr - 25 Abr, 2025
                  </span>
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-base text-tertiary">location_on</span>
                    Auditorio Central UNAS (Híbrido)
                  </span>
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-base text-outline">hub</span>
                    IncubaUNAS + ProInnóvate
                  </span>
                </div>
              </div>

              <!-- Item 2 -->
              <div class="border border-surface-container-highest rounded-xl p-4.5 bg-surface-bright hover:border-primary/50 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-3">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class="px-2 py-0.5 rounded text-xs font-bold bg-primary-fixed text-primary">En Evaluación Técnica</span>
                      <span class="text-xs text-secondary font-medium">• Jurados calificando</span>
                    </div>
                    <h3 class="font-title text-title font-bold text-on-surface">
                      Hackathon Amazonía Circular: Soluciones Cacao & Café Alto Huallaga
                    </h3>
                  </div>
                  <a
                    href="/dashboard/postulantes"
                    class="self-start sm:self-auto px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-surface-container-highest text-primary hover:bg-primary hover:text-on-primary text-label-sm font-label-sm font-semibold transition-colors flex items-center gap-1.5 whitespace-nowrap"
                  >
                    <span class="material-symbols-outlined text-base">how_to_reg</span>
                    <span>34 Postulantes</span>
                  </a>
                </div>

                <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-body-sm font-body-sm text-secondary pt-2 border-t border-surface-container">
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-base text-primary">calendar_month</span>
                    10 May - 12 May, 2025
                  </span>
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-base text-tertiary">location_on</span>
                    Campus Universitario UNAS - Coworking
                  </span>
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-base text-outline">hub</span>
                    Facultad de Agronomía & Cooperativas
                  </span>
                </div>
              </div>

              <!-- Item 3 -->
              <div class="border border-surface-container-highest rounded-xl p-4.5 bg-surface-bright hover:border-primary/50 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-3">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class="px-2 py-0.5 rounded text-xs font-bold bg-tertiary/10 text-tertiary">Inscripción Abierta</span>
                      <span class="text-xs text-secondary font-medium">• Próxima sesión mañana</span>
                    </div>
                    <h3 class="font-title text-title font-bold text-on-surface">
                      Semillero UNAS: Proyectos I+D+i Estudiantiles 2025-I
                    </h3>
                  </div>
                  <a
                    href="/dashboard/postulantes"
                    class="self-start sm:self-auto px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-surface-container-highest text-primary hover:bg-primary hover:text-on-primary text-label-sm font-label-sm font-semibold transition-colors flex items-center gap-1.5 whitespace-nowrap"
                  >
                    <span class="material-symbols-outlined text-base">how_to_reg</span>
                    <span>60 Postulantes</span>
                  </a>
                </div>

                <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-body-sm font-body-sm text-secondary pt-2 border-t border-surface-container">
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-base text-primary">calendar_month</span>
                    Ciclo Continuo 2025
                  </span>
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-base text-tertiary">location_on</span>
                    Laboratorio de Prototipado y Biotecnología
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent Applicants Quick Table -->
          <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-sm">
            <div class="flex items-center justify-between pb-4 border-b border-surface-container mb-5">
              <div>
                <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">Postulaciones Pendientes de Revisión</h2>
                <p class="font-body-sm text-body-sm text-secondary">Expedientes recibidos recientemente que requieren validación de admisibilidad.</p>
              </div>
              <a href="/dashboard/postulantes" class="text-primary hover:underline text-label-sm font-label-sm font-bold flex items-center gap-1">
                <span>Gestionar todas (14)</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </a>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-body-sm">
                <thead>
                  <tr class="border-b border-surface-container-highest text-secondary text-label-sm font-label-sm uppercase">
                    <th class="py-2.5 px-3">Proyecto / Emprendimiento</th>
                    <th class="py-2.5 px-3">Facultad UNAS</th>
                    <th class="py-2.5 px-3">Convocatoria</th>
                    <th class="py-2.5 px-3">Fecha</th>
                    <th class="py-2.5 px-3 text-right">Acción</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-surface-container">
                  <tr class="hover:bg-surface-container-low transition-colors">
                    <td class="py-3 px-3">
                      <div class="font-semibold text-on-surface">BioPlag Selva</div>
                      <span class="text-xs text-secondary">Bioplaguicidas botánicos</span>
                    </td>
                    <td class="py-3 px-3 text-secondary">Agronomía</td>
                    <td class="py-3 px-3 text-secondary text-xs">Bootcamp AgTech 2025</td>
                    <td class="py-3 px-3 text-secondary text-xs">Hace 2 horas</td>
                    <td class="py-3 px-3 text-right">
                      <a href="/dashboard/postulantes" class="px-2.5 py-1 rounded bg-primary-fixed text-primary font-label-sm text-xs font-semibold hover:bg-primary hover:text-on-primary transition-colors">
                        Revisar
                      </a>
                    </td>
                  </tr>
                  <tr class="hover:bg-surface-container-low transition-colors">
                    <td class="py-3 px-3">
                      <div class="font-semibold text-on-surface">CacaoSens IoT</div>
                      <span class="text-xs text-secondary">Sensorística de fermentación</span>
                    </td>
                    <td class="py-3 px-3 text-secondary">Ing. Informática</td>
                    <td class="py-3 px-3 text-secondary text-xs">Hackathon Circular</td>
                    <td class="py-3 px-3 text-secondary text-xs">Hace 5 horas</td>
                    <td class="py-3 px-3 text-right">
                      <a href="/dashboard/postulantes" class="px-2.5 py-1 rounded bg-primary-fixed text-primary font-label-sm text-xs font-semibold hover:bg-primary hover:text-on-primary transition-colors">
                        Revisar
                      </a>
                    </td>
                  </tr>
                  <tr class="hover:bg-surface-container-low transition-colors">
                    <td class="py-3 px-3">
                      <div class="font-semibold text-on-surface">NutriChonta Amazon</div>
                      <span class="text-xs text-secondary">Alimentos funcionales</span>
                    </td>
                    <td class="py-3 px-3 text-secondary">Recursos Naturales</td>
                    <td class="py-3 px-3 text-secondary text-xs">Bootcamp AgTech 2025</td>
                    <td class="py-3 px-3 text-secondary text-xs">Ayer</td>
                    <td class="py-3 px-3 text-right">
                      <a href="/dashboard/postulantes" class="px-2.5 py-1 rounded bg-primary-fixed text-primary font-label-sm text-xs font-semibold hover:bg-primary hover:text-on-primary transition-colors">
                        Revisar
                      </a>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Right: Upcoming sessions & Quick tools (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
          <!-- Calendar / Upcoming sessions -->
          <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-sm">
            <div class="flex items-center justify-between pb-3 border-b border-surface-container mb-4">
              <h3 class="font-title text-title font-bold text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-xl">schedule</span>
                <span>Próximas Jornadas</span>
              </h3>
              <span class="text-xs text-secondary font-medium">Abril 2025</span>
            </div>

            <div class="space-y-4">
              <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-bright border border-surface-container-highest">
                <div class="w-11 h-11 rounded-lg bg-primary text-on-primary flex flex-col items-center justify-center shrink-0">
                  <span class="text-xs font-bold leading-none">18</span>
                  <span class="text-[10px] uppercase font-semibold leading-none mt-0.5">ABR</span>
                </div>
                <div>
                  <div class="font-label-lg text-label-lg font-semibold text-on-surface leading-tight">Inauguración Bootcamp AgTech</div>
                  <div class="text-body-sm text-secondary text-xs mt-1">09:00 - 12:30 • Auditorio Central</div>
                  <span class="inline-block mt-1.5 px-2 py-0.5 rounded bg-tertiary/10 text-tertiary text-[11px] font-semibold">Presencial</span>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-bright border border-surface-container-highest">
                <div class="w-11 h-11 rounded-lg bg-surface-container text-on-surface flex flex-col items-center justify-center shrink-0">
                  <span class="text-xs font-bold leading-none">22</span>
                  <span class="text-[10px] uppercase font-semibold leading-none mt-0.5">ABR</span>
                </div>
                <div>
                  <div class="font-label-lg text-label-lg font-semibold text-on-surface leading-tight">Taller de Modelo Canvas & Pitch</div>
                  <div class="text-body-sm text-secondary text-xs mt-1">15:00 - 18:00 • Google Meet</div>
                  <span class="inline-block mt-1.5 px-2 py-0.5 rounded bg-primary-fixed text-primary text-[11px] font-semibold">Virtual</span>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-bright border border-surface-container-highest">
                <div class="w-11 h-11 rounded-lg bg-surface-container text-on-surface flex flex-col items-center justify-center shrink-0">
                  <span class="text-xs font-bold leading-none">25</span>
                  <span class="text-[10px] uppercase font-semibold leading-none mt-0.5">ABR</span>
                </div>
                <div>
                  <div class="font-label-lg text-label-lg font-semibold text-on-surface leading-tight">Pitch Day & Comité Evaluador</div>
                  <div class="text-body-sm text-secondary text-xs mt-1">14:00 - 18:00 • Sala Coworking</div>
                  <span class="inline-block mt-1.5 px-2 py-0.5 rounded bg-secondary-fixed text-secondary text-[11px] font-semibold">Híbrida</span>
                </div>
              </div>
            </div>
          </div>

          <!-- IncubaUNAS Institutional Links & Allies -->
          <div class="bg-surface-container-low/60 border border-surface-container-highest rounded-xl p-5">
            <h3 class="font-title text-title font-bold text-on-surface mb-3 flex items-center gap-2">
              <span class="material-symbols-outlined text-tertiary text-xl">verified</span>
              <span>Ecosistema Conectado</span>
            </h3>
            <p class="text-body-sm text-secondary mb-4 leading-relaxed">
              Dirección de Innovación y Transferencia Tecnológica (DITT) - UNAS Tingo María.
            </p>
            <div class="space-y-2 text-label-sm font-label-sm">
              <a href="https://www.unas.edu.pe" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-lowest border border-surface-container-highest hover:text-primary transition-colors">
                <span class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-base">school</span>
                  Portal Oficial UNAS
                </span>
                <span class="material-symbols-outlined text-sm">open_in_new</span>
              </a>
              <a href="https://proinnovate.gob.pe" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-lowest border border-surface-container-highest hover:text-primary transition-colors">
                <span class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-base">account_balance</span>
                  ProInnóvate Perú
                </span>
                <span class="material-symbols-outlined text-sm">open_in_new</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
