---
import Layout from '../../layouts/Layout.astro';
import DashboardSidebar from '../../components/DashboardSidebar.astro';
---

<Layout title="Gestión de Postulantes | IncubaUNAS" activeNav="convocar">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex flex-col lg:flex-row gap-8 items-start">
    <DashboardSidebar activeItem="postulantes" />

    <!-- MAIN POSTULANTES CONTENT -->
    <div class="flex-1 min-w-0 w-full space-y-6">
      <!-- Title & Actions Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-error-container text-on-error-container">
              14 Evaluaciones Pendientes
            </span>
            <span class="text-xs text-secondary font-medium">Ciclo Convocatorias 2025</span>
          </div>
          <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">
            Gestión de Postulantes
          </h1>
          <p class="font-body-md text-body-md text-secondary mt-1">
            Revisa solicitudes de inscripción, evalúa propuestas innovadoras y aprueba equipos para incubación.
          </p>
        </div>

        <div class="flex items-center gap-2 self-start sm:self-auto">
          <button
            id="exportCsvBtn"
            class="px-4 py-2.5 rounded-lg border border-surface-container-highest bg-surface-container-lowest hover:bg-surface-container text-on-surface font-label-lg text-label-lg font-semibold transition-colors flex items-center gap-2"
            type="button"
          >
            <span class="material-symbols-outlined text-lg text-secondary">file_download</span>
            <span>Exportar CSV</span>
          </button>
        </div>
      </div>

      <!-- Summary Metric Pills -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="p-4 rounded-xl bg-surface-container-lowest border border-surface-container-highest flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-error-container/60 text-on-error-container flex items-center justify-center font-bold">
            14
          </div>
          <div>
            <div class="text-xs text-secondary font-semibold">Pendientes</div>
            <div class="text-body-sm text-on-surface font-bold">Por Calificar</div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-surface-container-lowest border border-surface-container-highest flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-primary-fixed text-primary flex items-center justify-center font-bold">
            38
          </div>
          <div>
            <div class="text-xs text-secondary font-semibold">En Evaluación</div>
            <div class="text-body-sm text-on-surface font-bold">En Revisión Jurados</div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-surface-container-lowest border border-surface-container-highest flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-tertiary-fixed text-tertiary flex items-center justify-center font-bold">
            22
          </div>
          <div>
            <div class="text-xs text-secondary font-semibold">Aprobados</div>
            <div class="text-body-sm text-on-surface font-bold">Pasan a Incubación</div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-surface-container-lowest border border-surface-container-highest flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-secondary-container text-secondary flex items-center justify-center font-bold">
            6
          </div>
          <div>
            <div class="text-xs text-secondary font-semibold">Observados</div>
            <div class="text-body-sm text-on-surface font-bold">Por Subsanar</div>
          </div>
        </div>
      </div>

      <!-- Filters Toolbar -->
      <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-4 shadow-xs space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
          <!-- Search Input -->
          <div class="sm:col-span-4 relative">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-lg pointer-events-none">search</span>
            <input
              id="applicantSearchInput"
              type="text"
              placeholder="Buscar por proyecto, estudiante o código..."
              class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg pl-9 pr-3 py-2 text-body-sm text-on-surface placeholder:text-outline focus:border-primary outline-none"
            />
          </div>

          <!-- Convocatoria selector -->
          <div class="sm:col-span-3">
            <select id="convocatoriaFilter" class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg px-3 py-2 text-body-sm text-on-surface focus:border-primary outline-none">
              <option value="all">Todas las convocatorias</option>
              <option value="Bootcamp AgTech 2025">Bootcamp AgTech 2025</option>
              <option value="Hackathon Amazonía Circular">Hackathon Amazonía Circular</option>
              <option value="Semillero UNAS">Semillero UNAS</option>
            </select>
          </div>

          <!-- Facultad selector -->
          <div class="sm:col-span-3">
            <select id="facultadFilter" class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg px-3 py-2 text-body-sm text-on-surface focus:border-primary outline-none">
              <option value="all">Todas las facultades UNAS</option>
              <option value="Agronomía">Agronomía</option>
              <option value="Recursos Naturales">Recursos Naturales Renovables</option>
              <option value="Ing. Informática">Ing. Informática y Sistemas</option>
              <option value="Industrias Alimentarias">Industrias Alimentarias</option>
              <option value="Zootecnia">Zootecnia</option>
            </select>
          </div>

          <!-- Estado selector -->
          <div class="sm:col-span-2">
            <select id="statusFilter" class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg px-3 py-2 text-body-sm text-on-surface focus:border-primary outline-none">
              <option value="all">Todos los estados</option>
              <option value="Pendiente">Pendientes</option>
              <option value="En Evaluación">En Evaluación</option>
              <option value="Aprobado">Aprobados</option>
              <option value="Observado">Observados</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Applicants Table -->
      <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-body-sm">
            <thead>
              <tr class="bg-surface-container-low border-b border-surface-container-highest text-secondary text-label-sm font-label-sm uppercase">
                <th class="py-3 px-4">Proyecto / Startup</th>
                <th class="py-3 px-4">Líder & Facultad UNAS</th>
                <th class="py-3 px-4">Convocatoria</th>
                <th class="py-3 px-4 text-center">Score</th>
                <th class="py-3 px-4">Estado</th>
                <th class="py-3 px-4 text-right">Acción</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-container-highest" id="applicantsTableBody">
              <!-- Row 1 -->
              <tr class="applicant-row hover:bg-surface-container-low/50 transition-colors" data-convocatoria="Bootcamp AgTech 2025" data-facultad="Agronomía" data-status="Pendiente">
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-on-surface text-base">BioPlag Selva</div>
                  <div class="text-xs text-secondary mt-0.5">Bioplaguicidas a base de extractos de hojas de barbasco amazónico</div>
                  <span class="inline-block mt-1 px-2 py-0.2 rounded text-[11px] font-medium bg-surface-container text-secondary">Bioeconomía</span>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-medium text-on-surface">Juan Carlos Huamán</div>
                  <div class="text-xs text-secondary">Facultad de Agronomía • 9no ciclo</div>
                  <div class="text-[11px] text-tertiary">3 integrantes UNAS</div>
                </td>
                <td class="py-3.5 px-4 text-secondary text-xs">
                  <div class="font-medium text-on-surface">Bootcamp AgTech 2025</div>
                  <div>04 May 2025 (Hace 2h)</div>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <span class="text-xs text-outline font-medium">-- / 100</span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-error-container text-on-error-container">
                    Pendiente
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    class="evaluate-btn px-3 py-1.5 rounded-lg bg-primary hover:bg-surface-tint text-on-primary text-xs font-semibold shadow-xs transition-colors"
                    data-project="BioPlag Selva"
                    data-leader="Juan Carlos Huamán (Agronomía)"
                    data-desc="Bioplaguicidas botánicos contra plagas de broca del café."
                    data-score="0"
                    type="button"
                  >
                    Evaluar
                  </button>
                </td>
              </tr>

              <!-- Row 2 -->
              <tr class="applicant-row hover:bg-surface-container-low/50 transition-colors" data-convocatoria="Hackathon Amazonía Circular" data-facultad="Ing. Informática" data-status="En Evaluación">
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-on-surface text-base">CacaoSens IoT</div>
                  <div class="text-xs text-secondary mt-0.5">Módulos IoT de monitoreo de temperatura y pH en cajones de fermentación de cacao</div>
                  <span class="inline-block mt-1 px-2 py-0.2 rounded text-[11px] font-medium bg-surface-container text-secondary">AgTech & Hardware</span>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-medium text-on-surface">Andrea Quispe Rojas</div>
                  <div class="text-xs text-secondary">Ing. Informática y Sistemas • Egresada</div>
                  <div class="text-[11px] text-tertiary">4 integrantes UNAS</div>
                </td>
                <td class="py-3.5 px-4 text-secondary text-xs">
                  <div class="font-medium text-on-surface">Hackathon Amazonía Circular</div>
                  <div>03 May 2025</div>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <span class="text-xs font-bold text-primary px-2 py-0.5 rounded bg-primary-fixed">84 / 100</span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-primary-fixed text-primary">
                    En Evaluación
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    class="evaluate-btn px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface text-xs font-semibold transition-colors"
                    data-project="CacaoSens IoT"
                    data-leader="Andrea Quispe Rojas (Ing. Informática)"
                    data-desc="Sistema sensorizado para estandarizar la fermentación del grano fino de aroma."
                    data-score="84"
                    type="button"
                  >
                    Ver / Calificar
                  </button>
                </td>
              </tr>

              <!-- Row 3 -->
              <tr class="applicant-row hover:bg-surface-container-low/50 transition-colors" data-convocatoria="Bootcamp AgTech 2025" data-facultad="Recursos Naturales" data-status="Pendiente">
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-on-surface text-base">NutriChonta Amazon</div>
                  <div class="text-xs text-secondary mt-0.5">Harina prebiótica y snacks funcionales elaborados a partir de residuos de palmito</div>
                  <span class="inline-block mt-1 px-2 py-0.2 rounded text-[11px] font-medium bg-surface-container text-secondary">FoodTech</span>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-medium text-on-surface">Diego Valdivia Ríos</div>
                  <div class="text-xs text-secondary">Recursos Naturales Renovables • Tesista</div>
                  <div class="text-[11px] text-tertiary">2 integrantes UNAS</div>
                </td>
                <td class="py-3.5 px-4 text-secondary text-xs">
                  <div class="font-medium text-on-surface">Bootcamp AgTech 2025</div>
                  <div>02 May 2025</div>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <span class="text-xs text-outline font-medium">-- / 100</span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-error-container text-on-error-container">
                    Pendiente
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    class="evaluate-btn px-3 py-1.5 rounded-lg bg-primary hover:bg-surface-tint text-on-primary text-xs font-semibold shadow-xs transition-colors"
                    data-project="NutriChonta Amazon"
                    data-leader="Diego Valdivia Ríos (RRNN)"
                    data-desc="Aprovechamiento integral de la palma de chonta."
                    data-score="0"
                    type="button"
                  >
                    Evaluar
                  </button>
                </td>
              </tr>

              <!-- Row 4 -->
              <tr class="applicant-row hover:bg-surface-container-low/50 transition-colors" data-convocatoria="Hackathon Amazonía Circular" data-facultad="Industrias Alimentarias" data-status="Aprobado">
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-on-surface text-base">AmazonCoffee Roasters</div>
                  <div class="text-xs text-secondary mt-0.5">Micro-lotes de cafés de altura fermentados con levaduras nativas de la selva de Tingo María</div>
                  <span class="inline-block mt-1 px-2 py-0.2 rounded text-[11px] font-medium bg-surface-container text-secondary">Agroindustria</span>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-medium text-on-surface">Fiorella Mendoza</div>
                  <div class="text-xs text-secondary">Industrias Alimentarias • 10mo ciclo</div>
                  <div class="text-[11px] text-tertiary">4 integrantes UNAS</div>
                </td>
                <td class="py-3.5 px-4 text-secondary text-xs">
                  <div class="font-medium text-on-surface">Hackathon Amazonía Circular</div>
                  <div>01 May 2025</div>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <span class="text-xs font-bold text-tertiary px-2 py-0.5 rounded bg-tertiary/10">91 / 100</span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-tertiary/15 text-tertiary">
                    Aprobado
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    class="evaluate-btn px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface text-xs font-semibold transition-colors"
                    data-project="AmazonCoffee Roasters"
                    data-leader="Fiorella Mendoza (Ind. Alimentarias)"
                    data-desc="Café de especialidad con perfiles sensoriales de frutas exóticas."
                    data-score="91"
                    type="button"
                  >
                    Ver Ficha
                  </button>
                </td>
              </tr>

              <!-- Row 5 -->
              <tr class="applicant-row hover:bg-surface-container-low/50 transition-colors" data-convocatoria="Bootcamp AgTech 2025" data-facultad="Zootecnia" data-status="Observado">
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-on-surface text-base">BioPack Cascarilla</div>
                  <div class="text-xs text-secondary mt-0.5">Bandejas biodegradables a base de cascarilla de cacao y mucílago para viveros</div>
                  <span class="inline-block mt-1 px-2 py-0.2 rounded text-[11px] font-medium bg-surface-container text-secondary">Biomateriales</span>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-medium text-on-surface">Roberto Estrada</div>
                  <div class="text-xs text-secondary">Zootecnia / Agroforestería</div>
                  <div class="text-[11px] text-tertiary">2 integrantes</div>
                </td>
                <td class="py-3.5 px-4 text-secondary text-xs">
                  <div class="font-medium text-on-surface">Bootcamp AgTech 2025</div>
                  <div>29 Abr 2025</div>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <span class="text-xs font-bold text-secondary px-2 py-0.5 rounded bg-surface-container">58 / 100</span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-secondary-container text-on-secondary-container">
                    Observado
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    class="evaluate-btn px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface text-xs font-semibold transition-colors"
                    data-project="BioPack Cascarilla"
                    data-leader="Roberto Estrada (Zootecnia)"
                    data-desc="Falta adjuntar constancia de matrícula y desglose de costos del prototipo."
                    data-score="58"
                    type="button"
                  >
                    Ver Obs.
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Evaluation Modal Drawer -->
  <div id="evalModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-on-surface/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-surface-container-lowest border border-surface-container-highest rounded-2xl max-w-xl w-full shadow-2xl p-6 relative">
      <div class="flex items-center justify-between pb-4 border-b border-surface-container mb-4">
        <div>
          <span class="text-xs text-tertiary font-bold uppercase tracking-wider">Rúbrica de Calificación IncubaUNAS</span>
          <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface" id="modalProjectTitle">BioPlag Selva</h3>
          <p class="text-xs text-secondary" id="modalProjectLeader">Juan Carlos Huamán (Agronomía)</p>
        </div>
        <button id="closeModalBtn" type="button" class="p-1 rounded-lg hover:bg-surface-container text-secondary hover:text-on-surface">
          <span class="material-symbols-outlined text-2xl">close</span>
        </button>
      </div>

      <div class="space-y-4">
        <div class="p-3 bg-surface-container-low rounded-lg text-body-sm text-secondary" id="modalProjectDesc">
          Bioplaguicidas botánicos contra plagas de broca del café.
        </div>

        <div class="space-y-3">
          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span>Innovación y Diferencial (Máx 30 pts)</span>
              <span class="text-primary font-bold" id="score1Val">25</span>
            </div>
            <input type="range" min="0" max="30" value="25" class="w-full accent-primary" id="score1" />
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span>Viabilidad Técnica & Prototipo (Máx 30 pts)</span>
              <span class="text-primary font-bold" id="score2Val">24</span>
            </div>
            <input type="range" min="0" max="30" value="24" class="w-full accent-primary" id="score2" />
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span>Impacto en la Amazonía / Selva Central (Máx 25 pts)</span>
              <span class="text-primary font-bold" id="score3Val">22</span>
            </div>
            <input type="range" min="0" max="25" value="22" class="w-full accent-primary" id="score3" />
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span>Equipo Multidisciplinario UNAS (Máx 15 pts)</span>
              <span class="text-primary font-bold" id="score4Val">14</span>
            </div>
            <input type="range" min="0" max="15" value="14" class="w-full accent-primary" id="score4" />
          </div>
        </div>

        <div class="pt-3 border-t border-surface-container flex items-center justify-between">
          <span class="font-title text-title font-bold text-on-surface">Puntaje Total Calculado:</span>
          <span class="text-2xl font-headline-md font-bold text-tertiary" id="totalScore">85 / 100</span>
        </div>

        <div>
          <label class="block text-xs font-semibold text-on-surface mb-1">Observaciones o Recomendaciones del Jurado</label>
          <textarea
            class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg p-2.5 text-body-sm text-on-surface outline-none focus:border-primary"
            rows="3"
            placeholder="Escribe comentarios de retroalimentación técnica..."
          >Proyecto de alto potencial para el valle del Monzón y Tingo María. Se recomienda validar vida útil del extracto.</textarea>
        </div>

        <div class="pt-3 flex items-center justify-between gap-3">
          <button id="observeBtn" class="px-4 py-2 rounded-lg border border-outline-variant hover:bg-surface-container text-secondary text-xs font-semibold" type="button">
            Marcar con Observaciones
          </button>
          <button id="approveBtn" class="px-6 py-2 rounded-lg bg-tertiary hover:bg-tertiary-container text-on-tertiary font-bold text-sm shadow-sm" type="button">
            Aprobar e Ingresar a Incubación
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('applicantSearchInput') as HTMLInputElement | null;
    const convFilter = document.getElementById('convocatoriaFilter') as HTMLSelectElement | null;
    const facFilter = document.getElementById('facultadFilter') as HTMLSelectElement | null;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement | null;
    const rows = document.querySelectorAll<HTMLElement>('.applicant-row');

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const conv = convFilter?.value || 'all';
      const fac = facFilter?.value || 'all';
      const st = statusFilter?.value || 'all';

      rows.forEach((row) => {
        const text = row.textContent?.toLowerCase() || '';
        const rowConv = row.getAttribute('data-convocatoria') || '';
        const rowFac = row.getAttribute('data-facultad') || '';
        const rowStatus = row.getAttribute('data-status') || '';

        const matchQ = !q || text.includes(q);
        const matchConv = conv === 'all' || rowConv === conv;
        const matchFac = fac === 'all' || rowFac.includes(fac);
        const matchSt = st === 'all' || rowStatus === st;

        if (matchQ && matchConv && matchFac && matchSt) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    }

    searchInput?.addEventListener('input', applyFilters);
    convFilter?.addEventListener('change', applyFilters);
    facFilter?.addEventListener('change', applyFilters);
    statusFilter?.addEventListener('change', applyFilters);

    // Modal logic
    const modal = document.getElementById('evalModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const modalTitle = document.getElementById('modalProjectTitle');
    const modalLeader = document.getElementById('modalProjectLeader');
    const modalDesc = document.getElementById('modalProjectDesc');

    const s1 = document.getElementById('score1') as HTMLInputElement;
    const s2 = document.getElementById('score2') as HTMLInputElement;
    const s3 = document.getElementById('score3') as HTMLInputElement;
    const s4 = document.getElementById('score4') as HTMLInputElement;

    const s1Val = document.getElementById('score1Val');
    const s2Val = document.getElementById('score2Val');
    const s3Val = document.getElementById('score3Val');
    const s4Val = document.getElementById('score4Val');
    const totalScore = document.getElementById('totalScore');

    function updateTotal() {
      const sum = Number(s1?.value || 0) + Number(s2?.value || 0) + Number(s3?.value || 0) + Number(s4?.value || 0);
      if (s1Val) s1Val.textContent = s1.value;
      if (s2Val) s2Val.textContent = s2.value;
      if (s3Val) s3Val.textContent = s3.value;
      if (s4Val) s4Val.textContent = s4.value;
      if (totalScore) totalScore.textContent = `${sum} / 100`;
    }

    [s1, s2, s3, s4].forEach((input) => {
      input?.addEventListener('input', updateTotal);
    });

    document.querySelectorAll('.evaluate-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const project = btn.getAttribute('data-project') || '';
        const leader = btn.getAttribute('data-leader') || '';
        const desc = btn.getAttribute('data-desc') || '';
        if (modalTitle) modalTitle.textContent = project;
        if (modalLeader) modalLeader.textContent = leader;
        if (modalDesc) modalDesc.textContent = desc;
        updateTotal();
        modal?.classList.remove('hidden');
      });
    });

    closeModalBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    document.getElementById('approveBtn')?.addEventListener('click', () => {
      alert('¡Postulación evaluada y aprobada para el ciclo de incubación oficial!');
      modal?.classList.add('hidden');
    });

    document.getElementById('observeBtn')?.addEventListener('click', () => {
      alert('Se enviaron observaciones al correo del postulante para su subsanación.');
      modal?.classList.add('hidden');
    });

    document.getElementById('exportCsvBtn')?.addEventListener('click', () => {
      alert('Descargando lista de 142 postulantes en formato CSV...');
    });
  });
</script>
