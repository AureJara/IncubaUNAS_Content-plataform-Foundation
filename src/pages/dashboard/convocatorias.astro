---
import Layout from '../../layouts/Layout.astro';
import DashboardSidebar from '../../components/DashboardSidebar.astro';
---

<Layout title="Mis Convocatorias | IncubaUNAS" activeNav="convocar">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex flex-col lg:flex-row gap-8 items-start">
    <DashboardSidebar activeItem="convocatorias" />

    <!-- MAIN CONVOCATORIAS COLUMN -->
    <div class="flex-1 min-w-0 w-full space-y-6">
      <!-- Title & CTA Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">
            Mis Convocatorias
          </h1>
          <p class="font-body-md text-body-md text-secondary mt-1">
            Administra convocatorias, bootcamps, talleres y programas de incubación del ecosistema UNAS.
          </p>
        </div>

        <a
          href="/dashboard/crear"
          class="self-start sm:self-auto px-5 py-2.5 rounded-lg bg-primary hover:bg-surface-tint text-on-primary font-label-lg text-label-lg font-bold shadow-sm transition-all duration-150 active:scale-95 flex items-center gap-2 whitespace-nowrap"
        >
          <span class="material-symbols-outlined text-lg">add_circle</span>
          <span>+ Nueva Convocatoria</span>
        </a>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-4 shadow-xs space-y-4">
        <!-- Tabs -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 border-b border-surface-container">
          <button class="status-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-bold bg-primary text-on-primary transition-colors" data-status="all" type="button">
            Todas (5)
          </button>
          <button class="status-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-medium text-secondary hover:text-on-surface hover:bg-surface-container transition-colors" data-status="abierta" type="button">
            Abiertas (2)
          </button>
          <button class="status-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-medium text-secondary hover:text-on-surface hover:bg-surface-container transition-colors" data-status="evaluacion" type="button">
            En Evaluación (1)
          </button>
          <button class="status-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-medium text-secondary hover:text-on-surface hover:bg-surface-container transition-colors" data-status="borrador" type="button">
            Borradores (1)
          </button>
          <button class="status-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-medium text-secondary hover:text-on-surface hover:bg-surface-container transition-colors" data-status="finalizada" type="button">
            Finalizadas (1)
          </button>
        </div>

        <!-- Search input & sort -->
        <div class="flex flex-col sm:flex-row gap-3 items-center justify-between">
          <div class="relative w-full sm:max-w-md">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-lg pointer-events-none">search</span>
            <input
              id="searchConvocatoriaInput"
              type="text"
              placeholder="Buscar por título, etiqueta temática o entidad..."
              class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg pl-9 pr-4 py-2 text-body-sm font-body-sm text-on-surface placeholder:text-outline focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none"
            />
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto justify-end text-body-sm">
            <label class="text-secondary text-xs flex items-center gap-1.5 whitespace-nowrap">
              <span>Ordenar:</span>
              <select id="sortSelect" class="bg-surface-container-lowest border border-surface-container-highest rounded-lg px-2.5 py-1.5 text-xs text-on-surface focus:border-primary outline-none">
                <option value="recent">Más recientes</option>
                <option value="applicants">Mayor cantidad de postulantes</option>
                <option value="closing">Próximas a cerrar</option>
              </select>
            </label>
          </div>
        </div>
      </div>

      <!-- Convocatorias Cards Matrix -->
      <div class="space-y-4" id="convocatoriasContainer">
        <!-- Card 1 -->
        <div class="convocatoria-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-xs hover:border-outline-variant transition-all" data-status="abierta" data-title="Bootcamp de Innovación y AgTech 2025: Bioeconomía en la Selva Central" data-tags="AgTech Bioeconomía Innovación">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-surface-container mb-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-tertiary/10 text-tertiary flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                  Convocatoria Abierta
                </span>
                <span class="text-xs text-secondary">• Cierra el 30 de Abril, 2025 (Faltan 12 días)</span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-primary-fixed text-primary">Híbrida</span>
              </div>
              <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">
                Bootcamp de Innovación y AgTech 2025: Bioeconomía en la Selva Central
              </h2>
              <p class="font-body-sm text-body-sm text-secondary">
                Programa intensivo de maduración de proyectos agrobiotecnológicos, bioproductos y tecnologías para el agro amazónico.
              </p>
            </div>

            <div class="flex lg:flex-col items-center lg:items-end justify-between gap-3 shrink-0">
              <div class="text-left lg:text-right">
                <div class="text-2xl font-headline-md font-bold text-primary">48</div>
                <div class="text-xs text-secondary">Postulaciones recibidas</div>
              </div>
              <a
                href="/dashboard/postulantes"
                class="px-4 py-2 rounded-lg bg-primary hover:bg-surface-tint text-on-primary font-label-lg text-label-lg font-semibold shadow-xs transition-colors flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-base">how_to_reg</span>
                <span>Ver Postulantes</span>
              </a>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold text-secondary mr-1">Tags:</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">AgTech</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">Bioeconomía</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">Innovación</span>
            </div>

            <div class="flex items-center gap-3 text-secondary text-xs">
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm text-primary">domain</span>
                IncubaUNAS + ProInnóvate
              </span>
              <span>•</span>
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm text-tertiary">event_note</span>
                2 sesiones
              </span>
              <span>•</span>
              <a href="/dashboard/crear" class="text-primary hover:underline font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">edit</span> Editar
              </a>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="convocatoria-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-xs hover:border-outline-variant transition-all" data-status="evaluacion" data-title="Hackathon Amazonía Circular: Soluciones Cacao & Café Alto Huallaga" data-tags="FoodTech Sostenibilidad Pitch">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-surface-container mb-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary-fixed text-primary flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                  En Evaluación Técnica
                </span>
                <span class="text-xs text-secondary">• Deliberación de jurados en curso</span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-container text-on-surface">Presencial</span>
              </div>
              <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">
                Hackathon Amazonía Circular: Soluciones Cacao & Café Alto Huallaga
              </h2>
              <p class="font-body-sm text-body-sm text-secondary">
                Reto de innovación abierta enfocado en subproductos de cascarilla de cacao, aguas mieles del café y empaques biodegradables.
              </p>
            </div>

            <div class="flex lg:flex-col items-center lg:items-end justify-between gap-3 shrink-0">
              <div class="text-left lg:text-right">
                <div class="text-2xl font-headline-md font-bold text-on-surface">34</div>
                <div class="text-xs text-secondary">Equipos registrados</div>
              </div>
              <a
                href="/dashboard/postulantes"
                class="px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface font-label-lg text-label-lg font-semibold transition-colors flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-base">fact_check</span>
                <span>Evaluar Equipos</span>
              </a>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold text-secondary mr-1">Tags:</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">FoodTech</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">Sostenibilidad</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">Economía Circular</span>
            </div>

            <div class="flex items-center gap-3 text-secondary text-xs">
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm text-primary">domain</span>
                Facultad de Agronomía + Cooperativas
              </span>
              <span>•</span>
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm text-tertiary">event_note</span>
                3 sesiones
              </span>
              <span>•</span>
              <a href="/dashboard/crear" class="text-primary hover:underline font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">edit</span> Editar
              </a>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="convocatoria-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-xs hover:border-outline-variant transition-all" data-status="abierta" data-title="Semillero UNAS: Proyectos I+D+i Estudiantiles 2025-I" data-tags="Innovación Semillero Biotecnología">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-surface-container mb-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-tertiary/10 text-tertiary flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                  Convocatoria Abierta
                </span>
                <span class="text-xs text-secondary">• Admisión continua a semilleros UNAS</span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-container text-on-surface">Campus Tingo María</span>
              </div>
              <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">
                Semillero UNAS: Proyectos I+D+i Estudiantiles 2025-I
              </h2>
              <p class="font-body-sm text-body-sm text-secondary">
                Fondo de validación inicial para prototipos de tesis y proyectos formativos de las 8 facultades de la UNAS.
              </p>
            </div>

            <div class="flex lg:flex-col items-center lg:items-end justify-between gap-3 shrink-0">
              <div class="text-left lg:text-right">
                <div class="text-2xl font-headline-md font-bold text-primary">60</div>
                <div class="text-xs text-secondary">Estudiantes postulantes</div>
              </div>
              <a
                href="/dashboard/postulantes"
                class="px-4 py-2 rounded-lg bg-primary hover:bg-surface-tint text-on-primary font-label-lg text-label-lg font-semibold shadow-xs transition-colors flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-base">how_to_reg</span>
                <span>Ver Postulantes</span>
              </a>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold text-secondary mr-1">Tags:</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">Innovación</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">Semillero</span>
              <span class="px-2 py-0.5 rounded-md bg-surface-container text-xs text-on-surface font-medium">Biotecnología</span>
            </div>

            <div class="flex items-center gap-3 text-secondary text-xs">
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm text-primary">domain</span>
                IncubaUNAS Oficial
              </span>
              <span>•</span>
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm text-tertiary">event_note</span>
                4 sesiones
              </span>
              <span>•</span>
              <a href="/dashboard/crear" class="text-primary hover:underline font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">edit</span> Editar
              </a>
            </div>
          </div>
        </div>

        <!-- Card 4 (Borrador) -->
        <div class="convocatoria-card bg-surface-container-lowest border border-dashed border-outline-variant rounded-xl p-6 shadow-xs hover:border-primary/50 transition-all opacity-90" data-status="borrador" data-title="Programa de Aceleración Agroforestal y Cacao Nativo" data-tags="AgTech Bioeconomía Escalamiento">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-surface-container mb-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-error-container text-on-error-container flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                  Borrador Pendiente de Aprobación
                </span>
                <span class="text-xs text-secondary">• No publicado aún</span>
              </div>
              <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">
                Programa de Aceleración Agroforestal y Cacao Nativo
              </h2>
              <p class="font-body-sm text-body-sm text-secondary">
                Fondo concursable de capital semilla cofinanciado con cooperación técnica internacional para empresas graduadas de la UNAS.
              </p>
            </div>

            <div class="flex lg:flex-col items-center lg:items-end justify-between gap-3 shrink-0">
              <a
                href="/dashboard/crear"
                class="px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface font-label-lg text-label-lg font-semibold transition-colors flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-base">edit_document</span>
                <span>Continuar Editando</span>
              </a>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-secondary">
            <span>Última modificación: Ayer a las 18:40 por Carlos Pérez</span>
            <span class="text-tertiary font-semibold">Guardado localmente</span>
          </div>
        </div>

        <!-- Card 5 (Finalizada) -->
        <div class="convocatoria-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-xs opacity-75" data-status="finalizada" data-title="Taller de Propiedad Intelectual, Patentes y Marcas UNAS" data-tags="Patentes Legal Propiedad Intelectual">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-surface-container mb-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-surface-container text-secondary">
                  Finalizada
                </span>
                <span class="text-xs text-secondary">• Culminó el 15 de Marzo, 2025</span>
              </div>
              <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">
                Taller de Propiedad Intelectual, Patentes y Marcas UNAS
              </h2>
              <p class="font-body-sm text-body-sm text-secondary">
                Asesoría con especialistas de INDECOPI para la protección de invenciones amazónicas y marcas colectivas.
              </p>
            </div>

            <div class="flex lg:flex-col items-center lg:items-end justify-between gap-3 shrink-0">
              <div class="text-left lg:text-right">
                <div class="text-xl font-bold text-on-surface">85</div>
                <div class="text-xs text-secondary">Asistentes certificados</div>
              </div>
              <a
                href="/dashboard/participaciones"
                class="px-3 py-1.5 rounded-lg border border-surface-container-highest bg-surface-container-low hover:bg-surface-container text-secondary text-xs font-semibold flex items-center gap-1"
              >
                <span class="material-symbols-outlined text-sm">description</span>
                <span>Ver Informe</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.status-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.convocatoria-card');
    const searchInput = document.getElementById('searchConvocatoriaInput') as HTMLInputElement | null;

    let currentStatus = 'all';
    let searchQuery = '';

    function filterCards() {
      cards.forEach((card) => {
        const cardStatus = card.getAttribute('data-status') || '';
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        const tags = (card.getAttribute('data-tags') || '').toLowerCase();

        const matchStatus = currentStatus === 'all' || cardStatus === currentStatus;
        const matchSearch = !searchQuery || title.includes(searchQuery) || tags.includes(searchQuery);

        if (matchStatus && matchSearch) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-primary', 'text-on-primary', 'font-bold');
          b.classList.add('text-secondary', 'hover:text-on-surface', 'hover:bg-surface-container');
        });
        btn.classList.add('bg-primary', 'text-on-primary', 'font-bold');
        btn.classList.remove('text-secondary', 'hover:text-on-surface', 'hover:bg-surface-container');

        currentStatus = btn.getAttribute('data-status') || 'all';
        filterCards();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        filterCards();
      });
    }
  });
</script>
