---
import Layout from '../../layouts/Layout.astro';
import DashboardSidebar from '../../components/DashboardSidebar.astro';
---

<Layout title="Equipo & Mentores | IncubaUNAS" activeNav="convocar">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex flex-col lg:flex-row gap-8 items-start">
    <DashboardSidebar activeItem="equipo" />

    <!-- MAIN EQUIPO COLUMN -->
    <div class="flex-1 min-w-0 w-full space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">
            Equipo & Mentores
          </h1>
          <p class="font-body-md text-body-md text-secondary mt-1">
            Red de mentores certificados, jurados técnicos y coordinadores de campo de IncubaUNAS.
          </p>
        </div>

        <button
          id="openAddMentorModal"
          class="self-start sm:self-auto px-5 py-2.5 rounded-lg bg-primary hover:bg-surface-tint text-on-primary font-label-lg text-label-lg font-bold shadow-sm transition-all duration-150 active:scale-95 flex items-center gap-2"
          type="button"
        >
          <span class="material-symbols-outlined text-lg">person_add</span>
          <span>+ Registrar Mentor / Staff</span>
        </button>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 border-b border-surface-container">
        <button class="team-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-bold bg-primary text-on-primary transition-colors" data-category="all" type="button">
          Todos (18)
        </button>
        <button class="team-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-medium text-secondary hover:text-on-surface hover:bg-surface-container transition-colors" data-category="mentor" type="button">
          Mentores de Negocio (8)
        </button>
        <button class="team-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-medium text-secondary hover:text-on-surface hover:bg-surface-container transition-colors" data-category="tecnico" type="button">
          Especialistas Técnicos UNAS (6)
        </button>
        <button class="team-filter-btn px-3 py-1.5 rounded-lg text-label-sm font-label-sm font-medium text-secondary hover:text-on-surface hover:bg-surface-container transition-colors" data-category="externo" type="button">
          Jurados Externos (4)
        </button>
      </div>

      <!-- Mentors & Staff Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="teamCardsGrid">
        <!-- Mentor 1 -->
        <div class="team-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-primary/50 transition-all flex flex-col justify-between" data-category="mentor">
          <div>
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-primary-fixed text-primary font-bold flex items-center justify-center text-base">
                  MR
                </div>
                <div>
                  <h2 class="font-label-lg text-label-lg font-bold text-on-surface">Ing. Manuel Rodríguez</h2>
                  <div class="text-xs text-secondary font-medium">Coordinador de Incubación</div>
                  <span class="inline-block mt-0.5 text-[11px] text-primary font-semibold">DITT - UNAS Tingo María</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-tertiary/10 text-tertiary flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                Activo
              </span>
            </div>

            <p class="text-body-sm font-body-sm text-secondary mb-4 leading-relaxed">
              Especialista en desarrollo de sistemas agrohidropónicos, bioeconomía circular y formulación de proyectos para fondos concursables.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">AgTech</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Bioeconomía</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Fondos ProInnóvate</span>
            </div>
          </div>

          <div class="pt-3 border-t border-surface-container flex items-center justify-between text-xs">
            <span class="text-secondary font-medium">8 proyectos asignados</span>
            <a href="mailto:manuel.rodriguez@unas.edu.pe" class="text-primary hover:underline font-semibold flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">mail</span> Contactar
            </a>
          </div>
        </div>

        <!-- Mentor 2 -->
        <div class="team-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-primary/50 transition-all flex flex-col justify-between" data-category="tecnico">
          <div>
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-tertiary-fixed text-tertiary font-bold flex items-center justify-center text-base">
                  LM
                </div>
                <div>
                  <h2 class="font-label-lg text-label-lg font-bold text-on-surface">Dra. Lucía Mendoza</h2>
                  <div class="text-xs text-secondary font-medium">Mentora Científica & I+D</div>
                  <span class="inline-block mt-0.5 text-[11px] text-tertiary font-semibold">Facultad Recursos Naturales</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-tertiary/10 text-tertiary flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                Disponible
              </span>
            </div>

            <p class="text-body-sm font-body-sm text-secondary mb-4 leading-relaxed">
              Investigadora RENACYT especializada en bioprospección de especies nativas de la selva central, micropropagación y metabolitos secundarios.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Biotecnología</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Cacao Nativo</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Patentes</span>
            </div>
          </div>

          <div class="pt-3 border-t border-surface-container flex items-center justify-between text-xs">
            <span class="text-secondary font-medium">5 proyectos asignados</span>
            <a href="mailto:lucia.mendoza@unas.edu.pe" class="text-primary hover:underline font-semibold flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">mail</span> Contactar
            </a>
          </div>
        </div>

        <!-- Mentor 3 -->
        <div class="team-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-primary/50 transition-all flex flex-col justify-between" data-category="mentor">
          <div>
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-secondary-fixed text-secondary font-bold flex items-center justify-center text-base">
                  KA
                </div>
                <div>
                  <h2 class="font-label-lg text-label-lg font-bold text-on-surface">Lic. Karen Alvarado</h2>
                  <div class="text-xs text-secondary font-medium">Gestora de Aceleración & Pitch</div>
                  <span class="inline-block mt-0.5 text-[11px] text-secondary font-semibold">IncubaUNAS Hub</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-tertiary/10 text-tertiary flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                Activa
              </span>
            </div>

            <p class="text-body-sm font-body-sm text-secondary mb-4 leading-relaxed">
              Coach de pitch y estructuración comercial. Especialista en validación de hipótesis de negocio, pricing y preparación para Demo Day.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Pitch Training</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Business Model</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Startups</span>
            </div>
          </div>

          <div class="pt-3 border-t border-surface-container flex items-center justify-between text-xs">
            <span class="text-secondary font-medium">12 proyectos asesorados</span>
            <a href="mailto:karen.alvarado@unas.edu.pe" class="text-primary hover:underline font-semibold flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">mail</span> Contactar
            </a>
          </div>
        </div>

        <!-- Mentor 4 -->
        <div class="team-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-primary/50 transition-all flex flex-col justify-between" data-category="tecnico">
          <div>
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-surface-container text-on-surface font-bold flex items-center justify-center text-base">
                  WQ
                </div>
                <div>
                  <h2 class="font-label-lg text-label-lg font-bold text-on-surface">Dr. Walter Quispe</h2>
                  <div class="text-xs text-secondary font-medium">Evaluador Técnico de Proyectos</div>
                  <span class="inline-block mt-0.5 text-[11px] text-outline font-semibold">Facultad de Agronomía</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary-fixed text-primary flex items-center gap-1">
                Jurado
              </span>
            </div>

            <p class="text-body-sm font-body-sm text-secondary mb-4 leading-relaxed">
              Docente principal con amplia experiencia en evaluación de proyectos de transferencia tecnológica, sanidad vegetal y cultivo de café y cacao.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Agronomía</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">I+D+i</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Comité Técnico</span>
            </div>
          </div>

          <div class="pt-3 border-t border-surface-container flex items-center justify-between text-xs">
            <span class="text-secondary font-medium">Comité Calificador</span>
            <a href="mailto:walter.quispe@unas.edu.pe" class="text-primary hover:underline font-semibold flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">mail</span> Contactar
            </a>
          </div>
        </div>

        <!-- Mentor 5 -->
        <div class="team-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-primary/50 transition-all flex flex-col justify-between" data-category="externo">
          <div>
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-primary-fixed text-primary font-bold flex items-center justify-center text-base">
                  RB
                </div>
                <div>
                  <h2 class="font-label-lg text-label-lg font-bold text-on-surface">Ing. Roberto Benavides</h2>
                  <div class="text-xs text-secondary font-medium">Mentor Externo de Mercado</div>
                  <span class="inline-block mt-0.5 text-[11px] text-primary font-semibold">Coop. Cafetalera Alto Huallaga</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-secondary-fixed text-secondary flex items-center gap-1">
                Aliado Externo
              </span>
            </div>

            <p class="text-body-sm font-body-sm text-secondary mb-4 leading-relaxed">
              Líder gremial y empresario agrario con más de 15 años exportando café de especialidad y cacao fino a mercados de Europa y Norteamérica.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Exportaciones</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Cadena de Valor</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Mercados B2B</span>
            </div>
          </div>

          <div class="pt-3 border-t border-surface-container flex items-center justify-between text-xs">
            <span class="text-secondary font-medium">4 empresas en mentoría</span>
            <a href="#" class="text-primary hover:underline font-semibold flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">handshake</span> Convenio
            </a>
          </div>
        </div>

        <!-- Mentor 6 -->
        <div class="team-card bg-surface-container-lowest border border-surface-container-highest rounded-xl p-5 shadow-xs hover:border-primary/50 transition-all flex flex-col justify-between" data-category="mentor">
          <div>
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-tertiary-fixed text-tertiary font-bold flex items-center justify-center text-base">
                  JS
                </div>
                <div>
                  <h2 class="font-label-lg text-label-lg font-bold text-on-surface">Tec. Jorge Sánchez</h2>
                  <div class="text-xs text-secondary font-medium">Soporte Técnico y Streaming</div>
                  <span class="inline-block mt-0.5 text-[11px] text-tertiary font-semibold">Audiovisual UNAS</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-tertiary/10 text-tertiary flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                Operativo
              </span>
            </div>

            <p class="text-body-sm font-body-sm text-secondary mb-4 leading-relaxed">
              Coordinador logístico en salas de videoconferencia, transmisiones híbridas en vivo y soporte para las jornadas del auditorio central.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Transmisiones</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Salas Híbridas</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-on-surface">Soporte Campus</span>
            </div>
          </div>

          <div class="pt-3 border-t border-surface-container flex items-center justify-between text-xs">
            <span class="text-secondary font-medium">Staff Oficial UNAS</span>
            <a href="mailto:jorge.sanchez@unas.edu.pe" class="text-primary hover:underline font-semibold flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">mail</span> Contactar
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Mentor Modal -->
  <div id="addMentorModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-on-surface/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-surface-container-lowest border border-surface-container-highest rounded-2xl max-w-lg w-full shadow-2xl p-6">
      <div class="flex items-center justify-between pb-4 border-b border-surface-container mb-4">
        <div>
          <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">Registrar Mentor / Colaborador</h3>
          <p class="text-xs text-secondary">Acredita docentes UNAS o profesionales del ecosistema para asesorías.</p>
        </div>
        <button id="closeAddMentorModal" type="button" class="p-1 rounded-lg hover:bg-surface-container text-secondary hover:text-on-surface">
          <span class="material-symbols-outlined text-2xl">close</span>
        </button>
      </div>

      <form id="newMentorForm" class="space-y-4" onsubmit="event.preventDefault();">
        <div>
          <label class="block text-xs font-semibold text-on-surface mb-1">Nombre Completo *</label>
          <input type="text" required placeholder="Ej: Dr. Fernando Vela Ramírez" class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg px-3 py-2 text-body-sm text-on-surface outline-none focus:border-primary" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-on-surface mb-1">Correo Electrónico Institucional *</label>
          <input type="email" required placeholder="docente@unas.edu.pe" class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg px-3 py-2 text-body-sm text-on-surface outline-none focus:border-primary" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-on-surface mb-1">Rol a Desempeñar</label>
            <select class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg px-3 py-2 text-body-sm text-on-surface outline-none focus:border-primary">
              <option>Mentor de Incubación</option>
              <option>Jurado / Evaluador Técnico</option>
              <option>Asesor Especialista I+D</option>
              <option>Staff de Apoyo Logístico</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-on-surface mb-1">Facultad / Entidad</label>
            <input type="text" placeholder="Agronomía / ProInnóvate" class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg px-3 py-2 text-body-sm text-on-surface outline-none focus:border-primary" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-on-surface mb-1">Áreas de Especialidad / Tags (Separadas por comas)</label>
          <input type="text" placeholder="Biotecnología, Modelos de Negocio, Cacao" class="w-full bg-surface-container-low border border-surface-container-highest rounded-lg px-3 py-2 text-body-sm text-on-surface outline-none focus:border-primary" />
        </div>

        <div class="pt-3 border-t border-surface-container flex items-center justify-end gap-3">
          <button id="cancelMentorBtn" type="button" class="px-4 py-2 rounded-lg border border-outline-variant hover:bg-surface-container text-secondary text-xs font-semibold">
            Cancelar
          </button>
          <button id="saveMentorBtn" type="submit" class="px-6 py-2 rounded-lg bg-primary hover:bg-surface-tint text-on-primary font-bold text-sm shadow-sm">
            Guardar & Enviar Invitación
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.team-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.team-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-primary', 'text-on-primary', 'font-bold');
          b.classList.add('text-secondary', 'hover:text-on-surface', 'hover:bg-surface-container');
        });
        btn.classList.add('bg-primary', 'text-on-primary', 'font-bold');
        btn.classList.remove('text-secondary', 'hover:text-on-surface', 'hover:bg-surface-container');

        const cat = btn.getAttribute('data-category') || 'all';
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category') || '';
          if (cat === 'all' || cardCat === cat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    const modal = document.getElementById('addMentorModal');
    const openBtn = document.getElementById('openAddMentorModal');
    const closeBtn = document.getElementById('closeAddMentorModal');
    const cancelBtn = document.getElementById('cancelMentorBtn');
    const form = document.getElementById('newMentorForm');

    openBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
    closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));
    cancelBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

    form?.addEventListener('submit', () => {
      alert('¡Invitación enviada al correo del docente/mentor con sus credenciales de acceso a IncubaUNAS!');
      modal?.classList.add('hidden');
    });
  });
</script>
