          <!-- Facebook -->
          <a class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-container-low dark:bg-surface-variant hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 text-body-sm font-body-sm" href="#">
            <span class="material-symbols-outlined text-lg" data-icon="share">share</span>
            <span>Facebook</span>
          </a>
          <!-- YouTube -->
          <a class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-container-low dark:bg-surface-variant hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 text-body-sm font-body-sm" href="#">
            <span class="material-symbols-outlined text-lg" data-icon="smart_display">smart_display</span>
            <span>YouTube</span>
          </a>
          <!-- Instagram -->
          <a class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-container-low dark:bg-surface-variant hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 text-body-sm font-body-sm" href="#">
            <span class="material-symbols-outlined text-lg" data-icon="photo_camera">photo_camera</span>
            <span>Instagram</span>
          </a>
          <!-- LinkedIn -->
          <a class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-container-low dark:bg-surface-variant hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 text-body-sm font-body-sm" href="#">
            <span class="material-symbols-outlined text-lg" data-icon="badge">badge</span>
