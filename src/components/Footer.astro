          <li>
            <a class="hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 block" href="#">Políticas de cookies</a>
          </li>
          <li>
            <a class="hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 block" href="#">Comunidad</a>
          </li>
          <li>
            <a class="hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 block" href="#">Galería y eventos</a>
          </li>
        </ul>
