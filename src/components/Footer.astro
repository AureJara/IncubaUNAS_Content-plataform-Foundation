        <ul class="space-y-3 text-body-sm font-body-sm text-secondary dark:text-secondary-fixed-dim">
          <li class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-primary dark:text-inverse-primary text-lg shrink-0 mt-0.5" data-icon="location_on">location_on</span>
            <span>Dirección y mapa: Av. Innovación 450, Distrito Tecnológico</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-primary dark:text-inverse-primary text-lg shrink-0" data-icon="mail">mail</span>
            <a class="hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150" href="mailto:contacto@eventospro.com">contacto@eventospro.com</a>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-primary dark:text-inverse-primary text-lg shrink-0" data-icon="call">call</span>
            <a class="hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150" href="tel:+15552345678">+1 (555) 234-5678</a>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-primary dark:text-inverse-primary text-lg shrink-0" data-icon="chat">chat</span>
            <a class="hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 font-medium" href="#">Formulario de contacto: Escríbenos directamente</a>
          </li>
          <li class="flex items-center gap-2.5 pt-1">
            <span class="material-symbols-outlined text-primary dark:text-inverse-primary text-lg shrink-0" data-icon="schedule">schedule</span>
            <span>Horario de atención: 9:00 - 18:00</span>
          </li>
        </ul>
      </div>

      <!-- Columna 2: Legal -->
      <div>
        <h4 class="text-title font-title text-on-surface dark:text-inverse-on-surface mb-4">Legal</h4>
        <ul class="space-y-3 text-body-sm font-body-sm text-secondary dark:text-secondary-fixed-dim">
          <li>
            <a class="hover:text-primary dark:hover:text-inverse-primary transition-colors duration-150 block" href="#">Términos y condiciones</a>
