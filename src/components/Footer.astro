  <div class="w-full px-6 lg:px-12 py-12 max-w-7xl mx-auto">
    <!-- Three Columns Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 py-10" id="contacto">
      <!-- Columna 1: Contactos -->
      <div>
        <div class="mb-6">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCevF-uIwLZgNqwCTu3DE3pwO_sYQHbyFwnUo0ZpoQ-GJDrCDNizmLkf6Fr4eVWw65xtHqnO-KyC-qgbVQNkFj-hoSVZgY_FEdEoUSgrqvir2HG9w657GzS1DwmdZbyeLzgSvLbJC3kqSYyD5Ib0m8VcZiC-EoBrU3v-rCeWtRuqtdty6mUrdV4EeDLhqHV9c007KOuLzoEkmVEQE2ZFKIfM8L3o0WwttXvnMiuCRWRCpyPBoCY_EJc" alt="Incuba UNAS Logo" class="h-12 w-auto object-contain mb-4">
