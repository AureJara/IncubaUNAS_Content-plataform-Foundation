{
  "openapi": "3.1.0",
  "info": {
    "title": "Auth BFF y emisor de tokens (Equipo 1)",
    "version": "1.0.0",
    "description": "Login OIDC con PKCE, sesión por cookie, refresh y logout del gateway (spec 9.2), más las claves públicas de los tokens internos y la emisión de tokens de service accounts (spec 9.6). La API la sirve `gateway`.",
    "license": {
      "name": "Propietario (IncubaUNAS)",
      "identifier": "LicenseRef-IncubaUNAS"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Gateway local"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "session",
      "description": "Login OIDC, refresh y logout del BFF."
    },
    {
      "name": "tokens",
      "description": "Claves públicas y tokens de service accounts."
    },
    {
      "name": "health",
      "description": "Vida y disponibilidad del servicio."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "summary": "Health de vida",
        "tags": [
          "health"
        ],
        "security": [],
        "responses": {
          "200": {
            "$ref": "#/components/responses/HealthLive"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "summary": "Health de disponibilidad",
        "tags": [
          "health"
        ],
        "security": [],
        "responses": {
          "200": {
            "$ref": "#/components/responses/HealthReady"
          },
          "503": {
            "$ref": "#/components/responses/HealthNotReady"
          }
        }
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "startLogin",
        "summary": "Iniciar el login OIDC",
        "description": "Crea `state`, `nonce` y el verificador PKCE del lado del servidor y redirige al IdP. Un `return_to` fuera de la allowlist exacta lleva al inicio (RN-12).",
        "tags": [
          "session"
        ],
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirección al IdP.",
            "headers": {
              "Location": {
                "description": "URL de autorización del IdP.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                },
                "example": "http://localhost:8180/realms/incubaunas/protocol/openid-connect/auth?client_id=gateway&response_type=code&state=example-state"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "completeLogin",
        "summary": "Volver del IdP y crear la sesión",
        "description": "Valida `state`, `nonce`, PKCE, issuer y audience (PF-004).",
        "tags": [
          "session"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 256
            }
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "302": {
            "description": "Sesión creada; redirige al destino validado.",
            "headers": {
              "Location": {
                "description": "Destino de la allowlist.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                },
                "example": "/admin/"
              },
              "Set-Cookie": {
                "description": "Cookie de sesión `__Host-sid` (HttpOnly; Secure; SameSite=Lax).",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "Rotar la sesión",
        "description": "Cada refresh rota el ID; reutilizar uno rotado revoca la familia (RN-09).",
        "tags": [
          "session"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "204": {
            "description": "Cookie nueva.",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie de sesión rotada.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Cerrar la sesión",
        "description": "Revoca la sesión y limpia la cookie aunque falle el logout federado. Idempotente.",
        "tags": [
          "session"
        ],
        "security": [
          {
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "204": {
            "description": "Sesión cerrada.",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie vencida.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/auth/logout-all": {
      "post": {
        "operationId": "logoutAll",
        "summary": "Cerrar todas las sesiones del usuario",
        "tags": [
          "session"
        ],
        "x-recent-mfa": true,
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "204": {
            "description": "Todas las familias revocadas.",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie vencida.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "getJwks",
        "summary": "Claves públicas de los tokens internos",
        "tags": [
          "tokens"
        ],
        "responses": {
          "200": {
            "description": "JWKS con la clave vigente y la anterior durante la rotación.",
            "headers": {
              "Cache-Control": {
                "description": "Las claves se cachean poco tiempo.",
                "schema": {
                  "type": "string"
                },
                "example": "public, max-age=300"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Jwks"
                },
                "examples": {
                  "jwks": {
                    "$ref": "#/components/examples/jwks"
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "operationId": "issueServiceToken",
        "summary": "Token de una service account",
        "description": "`client_credentials` con secreto o con `private_key_jwt` (PF-011). La audience es exacta. Los errores siguen RFC 6749, no Problem Details.",
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "examples": {
                "client_secret": {
                  "$ref": "#/components/examples/token_request"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token interno con TTL corto.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                },
                "examples": {
                  "token": {
                    "$ref": "#/components/examples/token_response"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "examples": {
                  "invalid_scope": {
                    "$ref": "#/components/examples/oauth_invalid_scope"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Cliente inválido, vencido o revocado.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "examples": {
                  "invalid_client": {
                    "$ref": "#/components/examples/oauth_invalid_client"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-sid",
        "description": "Cookie de sesión opaca del BFF."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Token CSRF obligatorio en métodos que cambian estado."
      }
    },
    "schemas": {
      "Jwk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kty",
          "crv",
          "kid",
          "use",
          "alg",
          "x",
          "y"
        ],
        "properties": {
          "kty": {
            "type": "string",
            "const": "EC"
          },
          "crv": {
            "type": "string",
            "const": "P-256"
          },
          "kid": {
            "type": "string"
          },
          "use": {
            "type": "string",
            "const": "sig"
          },
          "alg": {
            "type": "string",
            "const": "ES256"
          },
          "x": {
            "type": "string"
          },
          "y": {
            "type": "string"
          }
        }
      },
      "Jwks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Jwk"
            }
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_type",
          "client_id",
          "audience"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "const": "client_credentials"
          },
          "client_id": {
            "type": "string",
            "maxLength": 128
          },
          "client_secret": {
            "type": "string",
            "maxLength": 256
          },
          "client_assertion_type": {
            "type": "string",
            "const": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"
          },
          "client_assertion": {
            "type": "string",
            "maxLength": 4096
          },
          "scope": {
            "type": "string",
            "maxLength": 1024
          },
          "audience": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,63}$"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "scope"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900
          },
          "scope": {
            "type": "string"
          }
        }
      },
      "OAuthError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_client",
              "invalid_grant",
              "unauthorized_client",
              "unsupported_grant_type",
              "invalid_scope"
            ]
          },
          "error_description": {
            "type": "string"
          }
        }
      },
      "HealthLive": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "HealthReady": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "environment",
          "checks",
          "operations"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "ci",
              "staging",
              "production"
            ]
          },
          "checks": {
            "type": "object",
            "description": "Estado de cada dependencia.",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "failing",
                "not_configured"
              ]
            }
          },
          "operations": {
            "type": "object",
            "description": "Estado de cada operación del contrato (MOCK-04).",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "example",
                "memory",
                "real"
              ]
            }
          }
        }
      },
      "ProblemError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "detail"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "description": "JSON Pointer del campo con error."
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "Código estable (spec 9.7)."
          },
          "detail": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemError"
            }
          }
        }
      }
    },
    "responses": {
      "HealthLive": {
        "description": "El proceso está vivo.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HealthLive"
            },
            "examples": {
              "ok": {
                "summary": "Vivo",
                "value": {
                  "status": "ok"
                }
              }
            }
          }
        }
      },
      "HealthReady": {
        "description": "Estado de las dependencias y de cada operación.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HealthReady"
            },
            "examples": {
              "ready": {
                "summary": "Listo, con operaciones en mock",
                "value": {
                  "status": "ready",
                  "environment": "local",
                  "checks": {
                    "contract": "ok"
                  },
                  "operations": {
                    "getMe": "example"
                  }
                }
              }
            }
          }
        }
      },
      "HealthNotReady": {
        "description": "Alguna dependencia falla.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HealthReady"
            },
            "examples": {
              "not_ready": {
                "summary": "Una dependencia falla",
                "value": {
                  "status": "not_ready",
                  "environment": "local",
                  "checks": {
                    "database": "failing"
                  },
                  "operations": {}
                }
              }
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Se superó el límite de solicitudes.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "rate_limited": {
                "$ref": "#/components/examples/problem_rate_limited"
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Parámetros o headers inválidos.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "bad_request": {
                "summary": "Header o parámetro inválido",
                "value": {
                  "type": "https://errors.example.pe/bad-request",
                  "title": "Bad request",
                  "status": 400,
                  "code": "bad_request",
                  "detail": "El parámetro `limit` debe estar entre 1 y 100.",
                  "request_id": "01933f5e-8c2a-7b4e-9a10-3c5d7e9f1a2b",
                  "errors": [
                    {
                      "pointer": "/query/limit",
                      "detail": "debe ser <= 100"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Sin sesión o con un token inválido.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "unauthorized": {
                "$ref": "#/components/examples/problem_unauthorized"
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Falta un scope, un rol o MFA reciente.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "forbidden": {
                "$ref": "#/components/examples/problem_forbidden"
              },
              "recent_auth_required": {
                "$ref": "#/components/examples/problem_mfa_required"
              }
            }
          }
        }
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "description": "Se acepta si es válido; si no, se genera. Siempre se devuelve.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{8,128}$"
        }
      }
    },
    "headers": {
      "NoStore": {
        "description": "Las respuestas privadas no se cachean.",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      },
      "RequestId": {
        "description": "Identificador del request (el recibido si era válido, o uno nuevo).",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Segundos que hay que esperar antes de reintentar.",
        "schema": {
          "type": "integer"
        }
      }
    },
    "examples": {
      "problem_rate_limited": {
        "summary": "Límite superado",
        "value": {
          "type": "https://errors.example.pe/rate-limited",
          "title": "Too many requests",
          "status": 429,
          "code": "rate_limited",
          "detail": "Demasiadas solicitudes. Intenta más tarde.",
          "request_id": "01933f5e-8c2a-7b4e-9a10-3c5d7e9f1a2b"
        }
      },
      "problem_unauthorized": {
        "summary": "Sin sesión o token inválido",
        "value": {
          "type": "https://errors.example.pe/unauthorized",
          "title": "Unauthorized",
          "status": 401,
          "code": "unauthorized",
          "detail": "Se necesita una sesión válida.",
          "request_id": "01933f5e-8c2a-7b4e-9a10-3c5d7e9f1a2b"
        }
      },
      "problem_forbidden": {
        "summary": "Falta un scope o un rol",
        "value": {
          "type": "https://errors.example.pe/forbidden",
          "title": "Forbidden",
          "status": 403,
          "code": "forbidden",
          "detail": "No tienes permiso para esta operación.",
          "request_id": "01933f5e-8c2a-7b4e-9a10-3c5d7e9f1a2b"
        }
      },
      "problem_mfa_required": {
        "summary": "Falta MFA reciente",
        "value": {
          "type": "https://errors.example.pe/recent-auth-required",
          "title": "Recent authentication required",
          "status": 403,
          "code": "recent_auth_required",
          "detail": "Vuelve a autenticarte con MFA para continuar.",
          "request_id": "01933f5e-8c2a-7b4e-9a10-3c5d7e9f1a2b"
        }
      },
      "jwks": {
