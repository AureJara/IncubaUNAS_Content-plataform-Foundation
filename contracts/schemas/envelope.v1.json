{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope canónico de eventos v1",
  "description": "Todo evento asíncrono lleva este sobre. `domain_event_id` identifica el hecho y es estable al republicar; `message_id` identifica cada publicación. Para eventos que no pertenecen a un evento de negocio, `business_event_id` es igual a `organization_id`. Los consumidores ignoran campos desconocidos.",
  "type": "object",
  "required": [
    "message_id",
    "domain_event_id",
    "topic",
    "schema_version",
    "producer",
    "organization_id",
    "business_event_id",
    "occurred_at",
    "published_at",
    "actor",
    "traceparent",
    "correlation_id",
    "aggregate",
    "partition_key",
    "data"
  ],
  "properties": {
    "message_id": { "type": "string", "format": "uuid" },
    "domain_event_id": { "type": "string", "format": "uuid" },
    "topic": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+\\.v[0-9]+$" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "producer": {
      "type": "string",
      "enum": ["platform", "content", "configuration", "participation", "onsite", "operations"]
    },
    "organization_id": { "type": "string", "format": "uuid" },
    "business_event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["user", "service", "system"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "traceparent": { "type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "causation_id": { "type": "string", "format": "uuid" },
    "aggregate": {
      "type": "object",
      "required": ["type", "id", "version"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "format": "uuid" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "partition_key": { "type": "string", "pattern": "^[0-9a-f-]{36}:[0-9a-f-]{36}$" },
    "data": { "type": "object" }
  }
}
