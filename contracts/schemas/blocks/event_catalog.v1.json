{
  "title": "Bloque de catálogo de eventos, versión 1",
  "description": "Guarda un filtro, nunca una copia de los eventos (PF-037).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "const": "event_catalog" },
    "version": { "type": "integer", "const": 1 },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "heading": { "type": "string", "maxLength": 120 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 24 },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modality": { "type": "string", "enum": ["in_person", "online", "hybrid"] },
            "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 63 },
            "from": { "type": "string", "format": "date" },
            "to": { "type": "string", "format": "date" }
          }
        }
      }
    }
  }
}
