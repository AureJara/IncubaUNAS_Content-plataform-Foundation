{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content.page.published.v1",
  "description": "Dueño: Equipo 1 (content). Consumen el CDN (purga por surrogate key) y auditoría.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.v1.json" }],
  "properties": {
    "topic": { "const": "content.page.published.v1" },
    "producer": { "const": "content" },
    "data": {
      "type": "object",
      "required": ["site_id", "page_id", "publication_id", "path", "locale", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "site_id": { "type": "string", "format": "uuid" },
        "page_id": { "type": "string", "format": "uuid" },
        "publication_id": { "type": "string", "format": "uuid" },
        "path": { "type": "string" },
        "locale": { "type": "string" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
