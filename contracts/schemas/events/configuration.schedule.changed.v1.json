{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "configuration.schedule.changed.v1",
  "description": "Dueño: Equipo 2 (configuration). Contrato del lado consumidor, pendiente de confirmar.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.v1.json" }],
  "properties": {
    "topic": { "const": "configuration.schedule.changed.v1" },
    "producer": { "const": "configuration" },
    "data": {
      "type": "object",
      "required": ["event_id", "publication_id", "schedule_hash", "affected_sessions"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "publication_id": { "type": "string", "format": "uuid" },
        "schedule_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "affected_sessions": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    }
  }
}
