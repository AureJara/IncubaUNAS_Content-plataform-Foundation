{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "platform.membership.changed.v1",
  "description": "Dueño: Equipo 1 (platform). Sin datos personales: el usuario va como identificador opaco y los roles como hash.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.v1.json" }],
  "properties": {
    "topic": { "const": "platform.membership.changed.v1" },
    "producer": { "const": "platform" },
    "data": {
      "type": "object",
      "required": ["membership_id", "user_id", "roles_scopes_hash", "state"],
      "additionalProperties": false,
      "properties": {
        "membership_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "roles_scopes_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "state": { "enum": ["invited", "active", "suspended", "revoked", "expired"] }
      }
    }
  }
}
