{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "platform.organization.lifecycle_changed.v1",
  "description": "Dueño: Equipo 1 (platform). Consumen los equipos 2 a 4.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.v1.json" }],
  "properties": {
    "topic": { "const": "platform.organization.lifecycle_changed.v1" },
    "producer": { "const": "platform" },
    "data": {
      "type": "object",
      "required": ["organization_id", "previous_state", "current_state", "effective_at"],
      "additionalProperties": false,
      "properties": {
        "organization_id": { "type": "string", "format": "uuid" },
        "previous_state": { "enum": ["provisioning", "active", "suspended", "archived", null] },
        "current_state": { "enum": ["provisioning", "active", "suspended", "archived"] },
        "effective_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
