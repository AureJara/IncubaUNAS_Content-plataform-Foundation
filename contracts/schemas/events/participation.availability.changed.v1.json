{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "participation.availability.changed.v1",
  "description": "Dueño: Equipo 3 (participation). Contrato del lado consumidor, pendiente de confirmar. La disponibilidad es informativa: Participation decide al registrar.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.v1.json" }],
  "properties": {
    "topic": { "const": "participation.availability.changed.v1" },
    "producer": { "const": "participation" },
    "data": {
      "type": "object",
      "required": ["event_id", "public_state", "remaining_band", "as_of"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "public_state": { "enum": ["not_open", "open", "waitlist_only", "closed"] },
        "remaining_band": { "enum": ["plenty", "few", "none", null] },
        "as_of": { "type": "string", "format": "date-time" }
      }
    }
  }
}
