{
  "name": "@incubaunas/web-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node --env-file=../../.env dist/server/entry.mjs",
    "typecheck": "astro check",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../contracts/openapi/public-read.v1.yaml -o src/lib/api-types.generated.ts",
    "test:smoke": "astro build && vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.9",
    "astro": "^7.4.5",
    "autoprefixer": "^10.6.2",
    "marked": "^18.1.3",
    "postcss": "^8.5.32",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/sanitize-html": "^2.16.2",
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.1.0"
  }
}
