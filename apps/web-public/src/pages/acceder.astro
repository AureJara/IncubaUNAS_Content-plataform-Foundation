---
import Layout from '../layouts/Layout.astro';
import { ADMIN_URL } from 'astro:env/server';

// El inicio de sesión vive en la Platform API (BFF + OIDC): este sitio nunca ve contraseñas.
// El botón lleva al panel, que inicia el flujo con el proveedor de identidad y vuelve a él al terminar.
const admin = ADMIN_URL.replace(/\/$/, '');
const loginHref = `${admin}/auth/login?return_to=${encodeURIComponent(`${admin}/`)}`;
---

<Layout title="Iniciar Sesión | IncubaUNAS" description="Accede con tu cuenta institucional a la plataforma de eventos y convocatorias de IncubaUNAS." activeNav="acceder">
  <div class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 relative overflow-hidden">
    <!-- Fondos atmosféricos y geometría sutil -->
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-tertiary/5 blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl mx-auto relative z-10">
      <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl shadow-[0_4px_24px_rgba(13,27,42,0.06)] overflow-hidden">
        <!-- Banda superior de estatus institucional -->
        <div class="h-1.5 w-full bg-gradient-to-r from-primary via-primary-container to-tertiary"></div>

        <div class="p-6 sm:p-10">
          <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center p-2 mb-4 rounded-xl bg-surface-container-low border border-surface-container-high">
              <img alt="IncubaUNAS" class="h-8 w-auto" width="85" height="32" src="/brand/logo.png" />
            </div>
            <h1 class="text-headline-md font-headline-md text-on-surface mb-2 tracking-tight">Iniciar Sesión</h1>
            <p class="text-body-md font-body-md text-secondary">
              Accede con tu cuenta institucional para gestionar tu organización, tus eventos y tus convocatorias.
            </p>
          </div>

          <div class="mb-6 p-3 rounded-lg bg-surface-container-low border border-surface-container-high flex items-start gap-2.5">
            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5 flex-shrink-0" aria-hidden="true">verified_user</span>
            <p class="text-body-sm font-body-sm text-secondary">
              Tu contraseña se escribe solo en el proveedor de identidad de la UNAS. Esta plataforma nunca la ve ni la guarda.
            </p>
          </div>

          <a
            href={loginHref}
            class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-primary-container text-on-primary-container font-label-lg text-label-lg font-bold shadow-md hover:brightness-110 active:scale-[0.99] transition-all"
          >
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">login</span>
            Continuar con mi cuenta
          </a>

          <!-- Registro y postulación para nuevos usuarios -->
          <div class="mt-8 text-center pt-5 border-t border-surface-container-high">
            <p class="text-body-sm font-body-sm text-secondary">
              ¿No tienes una cuenta de emprendedor?
              <a class="font-bold text-primary hover:text-primary-container transition-colors ml-1 inline-flex items-center gap-0.5" href="/convocar">
                Regístrate o Postula aquí
                <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_forward</span>
              </a>
            </p>
          </div>
        </div>
      </div>

      <!-- Ayuda técnica o de soporte -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-label-sm font-label-sm text-secondary">
        <a class="hover:text-on-surface transition-colors flex items-center gap-1" href="mailto:incubadora@unas.edu.pe">
          <span class="material-symbols-outlined text-[16px]" aria-hidden="true">help</span>
          Mesa de ayuda
        </a>
        <span aria-hidden="true">•</span>
        <a class="hover:text-on-surface transition-colors flex items-center gap-1" href="mailto:incubadora@unas.edu.pe">
          <span class="material-symbols-outlined text-[16px]" aria-hidden="true">mail</span>
          incubadora@unas.edu.pe
        </a>
      </div>
    </div>
  </div>
</Layout>
