---
import Layout from '../../layouts/Layout.astro';
import Blocks from '../../components/Blocks.astro';
import Container from '../../components/Container.astro';
import Notice from '../../components/Notice.astro';
import { getPreview, getSite, UpstreamError } from '../../lib/api';
import { pageTitle } from '../../lib/format';
import { siteSlug } from '../../lib/site';

// Vista previa de un borrador: nunca se cachea ni se indexa, y el token es de un solo uso.
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex');

let page = null;
let failed = false;
try {
  page = (await getPreview(Astro.params.token ?? '')).data;
} catch (error) {
  if (!(error instanceof UpstreamError)) throw error;
  failed = true;
}
if (!page && !failed) Astro.response.status = 404;
const site = (await getSite(siteSlug()).catch(() => ({ data: null }))).data;
const siteName = site?.name ?? 'IncubaUNAS';
---

<Layout title={pageTitle(page ? `Vista previa: ${page.title}` : 'Vista previa', siteName)} site={site} noindex>
  <Container class="space-y-8">
    {
      failed ? (
        <Notice tone="error">No pudimos cargar la vista previa.</Notice>
      ) : !page ? (
        <>
          <h1 class="text-headline-md-mobile md:text-headline-md font-headline-md text-on-surface">Vista previa no disponible</h1>
          <p class="text-body-md text-secondary">El enlace venció o ya se usó. Genera uno nuevo desde el panel.</p>
        </>
      ) : (
        <>
          <Notice>Estás viendo un borrador. No es público.</Notice>
          <Blocks blocks={page.blocks} locale={page.locale} />
        </>
      )
    }
  </Container>
</Layout>
