---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Convocar un Evento o Programa | IncubaUNAS" activeNav="convocar">
  <div class="py-8 lg:py-12 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto w-full">
    <!-- Header / Notice -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
          Convocar un Evento o Programa
        </h1>
        <p class="font-body-md text-body-md text-secondary mt-1.5 max-w-3xl">
          Publica y gestiona eventos, talleres y convocatorias de incubación y aceleración para el ecosistema emprendedor e innovador de la UNAS.
        </p>
      </div>
      <div>
        <a
          href="/convocar/crear"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-surface-container-high hover:bg-surface-variant text-on-surface text-label-lg font-semibold transition-colors"
        >
          <span class="material-symbols-outlined text-lg text-primary">edit_document</span>
          <span>Ir al Formulario (Sesión Iniciada)</span>
        </a>
      </div>
    </div>

    <!-- HERO ACCESS REQUIRED CARD -->
    <div class="bg-surface-container-lowest border border-surface-container-highest rounded-2xl p-8 lg:p-12 shadow-sm text-center relative overflow-hidden mb-12">
      <div class="max-w-2xl mx-auto relative z-10 flex flex-col items-center">
        <!-- Icon Badge -->
        <div class="w-16 h-16 rounded-2xl bg-primary-fixed text-primary flex items-center justify-center mb-6 shadow-sm">
          <span class="material-symbols-outlined text-4xl">admin_panel_settings</span>
        </div>
        <span class="inline-block px-3 py-1 rounded-full bg-secondary-container/50 text-secondary text-label-sm font-semibold mb-3">
          Autenticación Obligatoria
        </span>
        <h2 class="font-headline-md text-headline-md text-on-surface mb-3 tracking-tight">
          Inicia sesión para crear una convocatoria o evento
        </h2>
        <p class="font-body-md text-body-md text-secondary leading-relaxed mb-8">
          Para garantizar la autenticidad y el respaldo institucional de las convocatorias en el ecosistema IncubaUNAS, debes identificarte con tu cuenta institucional de la UNAS o registrarte como docente, organizador o entidad aliada.
        </p>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
          <a
            href="/acceder"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg bg-primary hover:bg-surface-tint text-on-primary font-label-lg text-label-lg font-bold shadow-md hover:shadow-lg transition-all duration-200 active:scale-95"
          >
            <span class="material-symbols-outlined text-xl">login</span>
            <span>Iniciar Sesión</span>
          </a>
          <a
            href="/convocar/crear"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg border border-primary text-primary hover:bg-primary hover:text-on-primary font-label-lg text-label-lg font-bold transition-all duration-200 active:scale-95"
          >
            <span class="material-symbols-outlined text-xl">visibility</span>
            <span>Simular Sesión Activa</span>
          </a>
        </div>

        <!-- Institutional Helper Notice -->
        <div class="mt-8 pt-6 border-t border-surface-container flex flex-wrap items-center justify-center gap-6 text-label-sm text-secondary">
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm text-tertiary">check_circle</span>
            Cuentas @unas.edu.pe admitidas
          </span>
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm text-tertiary">check_circle</span>
            Validación técnica automática
          </span>
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm text-tertiary">check_circle</span>
            Respaldo oficial DITT - UNAS
          </span>
        </div>
      </div>
    </div>

    <!-- BENEFITS / WHAT YOU CAN DO SECTION -->
    <div class="mb-12">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mb-2">
          Herramientas disponibles para organizadores y facultades
        </h3>
        <p class="font-body-sm text-body-sm text-secondary">
          Al identificarte como organizador oficial, desbloquearás el gestor integral de convocatorias de la UNAS:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Benefit 1 -->
        <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-sm transition-all hover:border-primary/40 flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-primary-fixed text-primary flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-2xl">tune</span>
          </div>
          <h4 class="font-title text-title text-on-surface font-bold mb-2">Gestión de Convocatorias</h4>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
            Personaliza criterios de postulación, cronograma con sesiones híbridas o presenciales y etapas de selección específicas.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-sm transition-all hover:border-primary/40 flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-tertiary-fixed text-tertiary flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-2xl">group_add</span>
          </div>
          <h4 class="font-title text-title text-on-surface font-bold mb-2">Co-organización y Staff</h4>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
            Asigna personal de apoyo logístico de IncubaUNAS, evaluadores y moderadores institucionales por correo electrónico.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-sm transition-all hover:border-primary/40 flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-secondary-container text-primary flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-2xl">campaign</span>
          </div>
          <h4 class="font-title text-title text-on-surface font-bold mb-2">Difusión en la Red UNAS</h4>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
            Alcance directo a facultades de Agronomía, Recursos Naturales Renovables, Zootecnia y círculos de investigación tecnológica.
          </p>
        </div>

        <!-- Benefit 4 -->
        <div class="bg-surface-container-lowest border border-surface-container-highest rounded-xl p-6 shadow-sm transition-all hover:border-primary/40 flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-secondary-fixed text-secondary font-bold flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-2xl">analytics</span>
          </div>
          <h4 class="font-title text-title text-on-surface font-bold mb-2">Monitoreo en Tiempo Real</h4>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
            Dashboard completo para calificar postulaciones, filtrar equipos, validar asistencia y descargar reportes para ProInnóvate.
          </p>
        </div>
      </div>
    </div>

    <!-- CONTACT / SUPPORT CALLOUT -->
    <div class="bg-surface-container-low/60 border border-surface-container-highest rounded-xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <span class="material-symbols-outlined text-primary text-3xl">contact_support</span>
        <div>
          <h4 class="font-label-lg text-label-lg font-bold text-on-surface">¿Representas a una entidad externa, empresa o cooperativa?</h4>
          <p class="font-body-sm text-body-sm text-secondary">Coordina con la Dirección de Innovación de la UNAS para formalizar convenios de co-organización.</p>
        </div>
      </div>
      <a
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-container-lowest hover:bg-surface-container border border-surface-container-highest text-primary font-label-md text-label-md font-semibold transition-colors whitespace-nowrap shadow-xs"
        href="mailto:contacto@eventospro.com"
      >
        <span>Contactar Coordinación</span>
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </div>
  </div>
</Layout>
