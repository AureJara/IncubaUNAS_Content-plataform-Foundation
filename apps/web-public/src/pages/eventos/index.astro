---
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import Notice from '../../components/Notice.astro';
import { getSite, listEvents, UpstreamError } from '../../lib/api';
import { kindLabel } from '../../lib/events';
import { pageTitle } from '../../lib/format';
import { siteSlug } from '../../lib/site';

const slug = siteSlug();
let site = null;
let events = null;
let failed = false;

try {
  const [siteResult, eventsResult] = await Promise.all([getSite(slug), listEvents(slug)]);
  site = siteResult.data;
  events = eventsResult.data;
  if (eventsResult.cache.cacheControl) Astro.response.headers.set('cache-control', eventsResult.cache.cacheControl);
  if (eventsResult.cache.surrogateKey) Astro.response.headers.set('surrogate-key', eventsResult.cache.surrogateKey);
} catch (error) {
  if (!(error instanceof UpstreamError)) throw error;
  failed = true;
  Astro.response.status = 503;
  Astro.response.headers.set('cache-control', 'no-store');
}

const locale = site?.locale ?? 'es-PE';
const items = events?.items ?? [];
// Los filtros rápidos salen de los tipos de evento que hay publicados, no de una lista fija.
const kinds = [...new Set(items.map((event) => event.kind))].sort((a, b) => a.localeCompare(b));
const PILL =
  'pill-btn px-3.5 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant transition-colors shrink-0 aria-pressed:bg-on-surface aria-pressed:text-surface-container-lowest aria-pressed:hover:bg-on-surface';
---

<Layout
  title={pageTitle('Eventos y convocatorias', site?.name ?? 'IncubaUNAS')}
  description="Descubre talleres, conferencias, demo days y bootcamps diseñados para fortalecer el ecosistema emprendedor e innovador de la Amazonía peruana."
  site={site}
  noindex={failed}
>
  <section class="relative bg-surface border-b border-surface-container-highest/60 overflow-hidden py-12 lg:py-16">
    <div class="absolute -top-24 right-0 w-96 h-96 bg-primary-fixed/30 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 left-0 w-80 h-80 bg-tertiary-fixed/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="max-w-3xl mb-8">
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-on-surface tracking-tight mb-4">
          Eventos y Convocatorias
        </h1>
        <p class="font-body-lg text-body-md md:text-body-lg text-secondary max-w-2xl leading-relaxed">
          Descubre talleres, conferencias, demo days y bootcamps diseñados para fortalecer el ecosistema emprendedor e innovador de la Amazonía peruana.
        </p>
      </div>

      <!-- Buscador: funciona con JavaScript, por eso nace oculto y el script lo muestra. -->
      <div id="event-filters" hidden class="bg-surface-container-lowest rounded-xl border border-surface-container-highest shadow-sm p-4 lg:p-6">
        <form id="event-search-form" role="search" class="relative">
          <label for="event-search" class="sr-only">Buscar eventos</label>
          <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline" aria-hidden="true">search</span>
          <input
            id="event-search"
            type="search"
            autocomplete="off"
            placeholder="Buscar por nombre, tipo o palabra clave..."
            class="w-full pl-11 pr-4 py-3 rounded-lg border border-surface-container-highest bg-surface-container-lowest text-on-surface placeholder:text-outline text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
          />
        </form>

        {
          kinds.length > 1 && (
            <div class="flex items-center gap-2 pt-4 mt-4 border-t border-surface-container overflow-x-auto no-scrollbar text-label-md" role="group" aria-label="Filtrar por tipo">
              <span class="text-secondary font-medium mr-1 flex items-center gap-1 shrink-0">
                <span class="material-symbols-outlined text-sm" aria-hidden="true">label</span>
                Filtro rápido:
              </span>
              <button type="button" class={PILL} data-kind="" aria-pressed="true">Todos</button>
              {kinds.map((kind) => (
                <button type="button" class={PILL} data-kind={kind} aria-pressed="false">
                  {kindLabel(kind)}
                </button>
              ))}
            </div>
          )
        }
      </div>

      {
        !failed && (
          <p class="mt-6 text-body-sm text-secondary" aria-live="polite">
            Mostrando <span id="event-count" class="font-semibold text-on-surface">{items.length}</span>
            {items.length === 1 ? ' evento' : ' eventos'}
          </p>
        )
      }
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 lg:px-12 py-12">
    {
      failed ? (
        <Notice tone="error">No pudimos cargar los eventos. Inténtalo de nuevo en unos minutos.</Notice>
      ) : items.length === 0 ? (
        <Notice>Por ahora no hay eventos publicados.</Notice>
      ) : (
        <>
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="events-grid">
            {items.map((event) => (
              <li class="flex" data-event-item>
                <EventCard event={event} locale={locale} />
              </li>
            ))}
          </ul>
          <div id="event-empty" hidden>
            <Notice>Ningún evento coincide con tu búsqueda.</Notice>
          </div>
        </>
      )
    }
  </section>
</Layout>

<script>
  const filters = document.getElementById('event-filters');
  const search = document.getElementById('event-search') as HTMLInputElement | null;
  const pills = document.querySelectorAll<HTMLButtonElement>('.pill-btn');
  const items = document.querySelectorAll<HTMLElement>('[data-event-item]');
  const count = document.getElementById('event-count');
  const empty = document.getElementById('event-empty');

  let kind = '';
  let query = '';

  function apply() {
    let visible = 0;
    items.forEach((item) => {
      const itemKind = item.querySelector<HTMLElement>('.event-card')?.dataset.kind ?? '';
      const matches = (!kind || itemKind === kind) && (item.textContent ?? '').toLowerCase().includes(query);
      item.toggleAttribute('hidden', !matches);
      if (matches) visible += 1;
    });
    if (count) count.textContent = String(visible);
    empty?.toggleAttribute('hidden', visible > 0);
  }

  if (filters && items.length > 0) {
    filters.removeAttribute('hidden');
    // Enter no recarga la página: el filtro ya se aplicó al escribir.
    document.getElementById('event-search-form')?.addEventListener('submit', (event) => event.preventDefault());
    search?.addEventListener('input', () => {
      query = search.value.trim().toLowerCase();
      apply();
    });
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        kind = pill.dataset.kind ?? '';
        pills.forEach((other) => other.setAttribute('aria-pressed', String(other === pill)));
        apply();
      });
    });
  }
</script>
