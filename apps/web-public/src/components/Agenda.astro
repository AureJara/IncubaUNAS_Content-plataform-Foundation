---
import { formatTime } from '../lib/format';
import type { PublicEvent } from '../lib/api';

interface Props {
  event: PublicEvent;
  locale: string;
}

const { event, locale } = Astro.props;
// Programas simultáneos: una columna por programa, con sus sesiones ordenadas por hora.
const tracks = [
  ...event.programs,
  ...(event.sessions.some((s) => !s.program_slug) ? [{ slug: '', name: 'Sesiones generales', color: null }] : []),
];
const sessionsOf = (slug: string) =>
  event.sessions
    .filter((s) => (s.program_slug ?? '') === slug)
    .sort((a, b) => a.starts_at.localeCompare(b.starts_at));
// El color llega de la API: solo se emite si es un hex válido.
const safeColor = (c: string | null | undefined) => (c && /^#[0-9a-fA-F]{6}$/.test(c) ? c : undefined);
---

{
  event.sessions.length === 0 ? (
    <p class="rounded-lg border-l-4 border-primary bg-primary/5 px-4 py-3 text-body-md text-secondary">
      La agenda se publicará pronto.
    </p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tracks.map((track) => (
        <section
          class="rounded-xl border border-surface-container-highest bg-surface-container-lowest p-5 border-t-4 border-t-primary shadow-sm"
          aria-labelledby={`track-${track.slug || 'general'}`}
          style={safeColor(track.color) ? `border-top-color:${safeColor(track.color)}` : undefined}
        >
          <h3 id={`track-${track.slug || 'general'}`} class="text-headline-sm font-headline-sm text-on-surface mb-4">
            {track.name}
          </h3>
          <ol class="space-y-4">
            {sessionsOf(track.slug).map((session) => (
              <li class="border-l-2 border-surface-container-high pl-4">
                <p class="text-label-md font-label-md text-primary tabular-nums">
                  <time datetime={session.starts_at}>{formatTime(session.starts_at, event.timezone, locale)}</time>
                  {' – '}
                  <time datetime={session.ends_at}>{formatTime(session.ends_at, event.timezone, locale)}</time>
                </p>
                <h4 class="text-title font-title text-on-surface">{session.title}</h4>
                {session.venue_name && (
                  <p class="flex items-center gap-1 text-body-sm font-body-sm text-secondary">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">place</span>
                    {session.venue_name}
                  </p>
                )}
                {session.speakers && session.speakers.length > 0 && (
                  <p class="flex items-center gap-1 text-body-sm font-body-sm text-secondary">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">mic</span>
                    {session.speakers.join(', ')}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )
}
