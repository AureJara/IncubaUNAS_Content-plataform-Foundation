---
interface Props {
  /** `error` anuncia el mensaje de inmediato a los lectores de pantalla; `info` lo deja como estado. */
  tone?: 'info' | 'error';
}
const { tone = 'info' } = Astro.props;
const classes =
  tone === 'error'
    ? 'border-error bg-error-container/40 text-on-error-container'
    : 'border-primary bg-primary/5 text-secondary';
---

<p class={`rounded-lg border-l-4 px-4 py-3 text-body-md font-body-md ${classes}`} role={tone === 'error' ? 'alert' : 'status'}>
  <slot />
</p>
