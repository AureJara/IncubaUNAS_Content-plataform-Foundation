---
// Fuentes autoalojadas: la CSP no permite hojas de estilo ni fuentes de terceros.
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/material-symbols-outlined/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { resolveNavigation } from '../lib/nav';
import { themeStyle } from '../lib/theme';
import { loadSite } from '../lib/site';
import type { PublicSite } from '../lib/api';

interface Props {
  /** Título completo de la pestaña (las páginas dinámicas lo componen con `pageTitle`). */
  title?: string;
  description?: string;
  canonical?: string;
  /** Sitio publicado en el CMS: aporta nombre, idioma, menú y tema. Si la API no responde, es `null`. */
  site?: PublicSite | null;
  /** Los borradores y las páginas de error no se indexan. */
  noindex?: boolean;
  hideFooter?: boolean;
  /** Se conserva por compatibilidad con las páginas estáticas del diseño; el menú calcula el activo por ruta. */
  activeNav?: string;
}

const {
  title = 'IncubaUNAS | Plataforma de Eventos, Convocatorias y Emprendimiento',
  description = 'Incubadora de empresas de la Universidad Nacional Agraria de la Selva - Impulsando startups e innovación desde la Amazonía.',
  canonical,
  noindex = false,
  hideFooter = false,
} = Astro.props;

// Una página que ya leyó el sitio lo pasa (incluso como `null` si la API falló); las estáticas lo cargan aquí.
const site = Astro.props.site !== undefined ? Astro.props.site : await loadSite();
const siteName = site?.name ?? 'IncubaUNAS';
const navigation = resolveNavigation(site);
---

<!doctype html>
<html lang={site?.locale ?? 'es-PE'} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    style={themeStyle(site?.theme)}
    class="bg-background text-on-surface antialiased selection:bg-primary selection:text-on-primary min-h-screen flex flex-col font-body-md text-body-md"
  >
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header siteName={siteName} navigation={navigation} />

    <main id="contenido" tabindex="-1" class="flex-grow focus:outline-none">
      <slot />
    </main>

    {!hideFooter && <Footer siteName={siteName} />}
  </body>
</html>
