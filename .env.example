# Copia este archivo a `.env` (que git ignora). Los valores de abajo son SOLO para desarrollo local
# con docker compose. Nunca pongas credenciales reales aquí: el repositorio es público.

# --- PostgreSQL (una base lógica por servicio) ---
POSTGRES_ADMIN_PASSWORD=dev_only_admin_password
PLATFORM_DB_MIGRATOR_PASSWORD=dev_only_platform_migrator
PLATFORM_DB_APP_PASSWORD=dev_only_platform_app
CONTENT_DB_MIGRATOR_PASSWORD=dev_only_content_migrator
CONTENT_DB_APP_PASSWORD=dev_only_content_app

PLATFORM_DATABASE_ADMIN_URL=postgres://platform_migrator:dev_only_platform_migrator@localhost:5432/platform
PLATFORM_DATABASE_URL=postgres://platform_app:dev_only_platform_app@localhost:5432/platform
CONTENT_DATABASE_ADMIN_URL=postgres://content_migrator:dev_only_content_migrator@localhost:5432/content
CONTENT_DATABASE_URL=postgres://content_app:dev_only_content_app@localhost:5432/content

# --- OIDC (Keycloak local) ---
OIDC_ISSUER=http://localhost:8080/realms/incubaunas
OIDC_CLIENT_ID=platform-bff
OIDC_CLIENT_SECRET=dev_only_oidc_client_secret
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
OIDC_RETURN_TO_ALLOWLIST=http://localhost:3000/,http://localhost:4321/

# --- Servicios ---
PLATFORM_API_PORT=4000
CONTENT_API_PORT=4001
# Clave de firma de tokens internos entre servicios (genera una distinta por entorno)
INTERNAL_JWT_SECRET=dev_only_internal_jwt_secret_change_me_32chars
SESSION_COOKIE_NAME=__Host-session

# --- Platform API ---
OIDC_ALLOW_INSECURE=true
COOKIE_SECURE=true
CSRF_SECRET=dev_only_csrf_secret_change_me_32chars!!
# 32 bytes en base64. Genera una distinta por entorno: openssl rand -base64 32
PII_ENCRYPTION_KEY=ZGV2LW9ubHktcGlpLWtleS1kby1ub3QtdXNlLXByb2Q=
INTERNAL_JWT_ISSUER=https://platform.incubaunas.local
INTERNAL_JWT_AUDIENCE=platform-api
ADMIN_BASE_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=IncubaUNAS <no-reply@incubaunas.local>
LOG_LEVEL=info

# --- Sitio público (Astro) ---
CONTENT_API_URL=http://localhost:4001
# Un despliegue sirve un sitio; la resolución dominio → sitio llega con el gateway.
SITE_SLUG=demo
MEDIA_BASE_URL=
# Origen del panel: ahí vive el inicio de sesión (BFF + OIDC). La página /acceder del sitio público apunta aquí.
ADMIN_URL=http://localhost:3000
