# Copia este archivo a .env para desarrollo local. Nunca pongas secretos reales en este archivo (el repositorio es público).

# Entorno: local | ci | staging | production. Los mocks solo existen en local y ci (spec 3.8, MOCK-06).
APP_ENV=local
LOG_LEVEL=info

# Fuente de datos de los casos de uso: memory | real (MOCK-03).
DATA_SOURCE=memory

# Sesión de prueba del gateway (MOCK-05): rol del usuario ficticio.
# Valores: org_owner | security_admin | site_editor | event_manager | application_reviewer | checkin_staff | report_viewer
MOCK_ROLE=site_editor

# Puertos
GATEWAY_PORT=8080
PLATFORM_API_PORT=8081
CONTENT_CMS_PORT=8082
CONTENT_PUBLIC_PORT=8083
WEB_PUBLIC_PORT=3000
ADMIN_SHELL_PORT=5173

# Direcciones internas
GATEWAY_ISSUER=http://localhost:8080
GATEWAY_JWKS_URL=http://localhost:8080/.well-known/jwks.json
PLATFORM_API_URL=http://localhost:8081
CONTENT_CMS_URL=http://localhost:8082
CONTENT_PUBLIC_URL=http://localhost:8083

# Frontends: el shell llega a las APIs por el gateway (mismo origen vía el proxy de Vite) y web-public lee la Public
# Read API desde su servidor.
GATEWAY_URL=http://localhost:8080
